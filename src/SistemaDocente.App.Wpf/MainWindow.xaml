<Window x:Class="SistemaDocente.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema Docente Local" Height="740" Width="1060" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="110"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    </Window.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,12" Background="#173F5F"
                Visibility="{Binding MostrarNavegacion, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="White"
                           FontSize="18" FontWeight="SemiBold" Text="Sistema Docente Local"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Grupo" Command="{Binding IrAGrupoCommand}"/>
                    <Button Content="Asistencia" Command="{Binding IrAAsistenciaCommand}"/>
                    <Button Content="Proyectos" Command="{Binding IrAProyectosCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" DataContext="{Binding Grupo}"
              Visibility="{Binding DataContext.MostrarGrupo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="28" Visibility="{Binding MostrarBienvenida, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="1" MaxWidth="620" Padding="36" Background="White" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Bienvenido a Sistema Docente Local" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,10,0,22" TextWrapping="Wrap" Text="Comienza escribiendo el nombre del grupo que administras."/>
                        <TextBlock Text="Nombre del grupo" FontWeight="SemiBold"/>
                        <TextBox x:Name="NombreGrupoInicial" TabIndex="0" Text="{Binding NombreNuevoGrupo, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding CrearGrupoCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="{Binding MensajeEdicion}"/>
                        <WrapPanel><Button TabIndex="1" Content="Crear grupo" IsDefault="True" Command="{Binding CrearGrupoCommand}"/><Button TabIndex="2" Content="Olvidar referencia" Command="{Binding OlvidarReferenciaCommand}"/></WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="28" Visibility="{Binding MostrarGestion, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Left"><TextBlock Text="Grupo" Foreground="#52606D"/><TextBlock Text="{Binding NombreGrupo}" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" TabIndex="10" Content="Cambiar nombre" Command="{Binding AbrirCambioNombreCommand}"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Estudiantes}" SelectedItem="{Binding EstudianteSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" TabIndex="20" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" FontSize="15">
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding EstaActivo}" Value="False"><Setter Property="Foreground" Value="#5D6670"/><Setter Property="Background" Value="#ECEFF2"/><Setter Property="FontStyle" Value="Italic"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                    <DataGrid.Columns><DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="90"/><DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/></DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,14,0,6"><Button Content="Agregar estudiante" Command="{Binding AbrirAgregarEstudianteCommand}"/><Button Content="Editar estudiante" Command="{Binding AbrirEditarEstudianteCommand}"/><Button Content="Desactivar" Command="{Binding DesactivarEstudianteCommand}"/><Button Content="Reactivar" Command="{Binding ReactivarEstudianteCommand}"/></WrapPanel>
                <Border Grid.Row="3" Padding="18" Background="White" CornerRadius="8" Visibility="{Binding MostrarEditorGrupo, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel><TextBlock Text="Cambiar nombre del grupo" FontSize="19" FontWeight="SemiBold"/><TextBlock Margin="0,10,0,0" Text="Nuevo nombre"/><TextBox x:Name="NombreGrupoEdicion" Text="{Binding NombreEdicionGrupo, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarNombreGrupoCommand}"/></TextBox.InputBindings></TextBox><TextBlock Foreground="#B42318" Text="{Binding MensajeEdicion}"/><WrapPanel><Button Content="Guardar nombre" Command="{Binding GuardarNombreGrupoCommand}"/><Button Content="Cancelar" Command="{Binding CancelarEdicionCommand}"/></WrapPanel></StackPanel>
                </Border>
                <Border Grid.Row="3" Padding="18" Background="White" CornerRadius="8" Visibility="{Binding MostrarEditorEstudiante, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel><TextBlock Text="{Binding TituloEditorEstudiante}" FontSize="19" FontWeight="SemiBold"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nombre"/><TextBox x:Name="NombreEstudianteEdicion" Text="{Binding NombreEstudianteEdicion, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Número de lista"/><TextBox Text="{Binding NumeroListaEdicion, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/></TextBox.InputBindings></TextBox></StackPanel></Grid><TextBlock Foreground="#B42318" Text="{Binding MensajeEdicion}"/><WrapPanel><Button Content="Guardar estudiante" Command="{Binding GuardarEstudianteCommand}"/><Button Content="Cancelar" Command="{Binding CancelarEdicionCommand}"/></WrapPanel></StackPanel>
                </Border>
            </Grid>
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="18" Padding="12,7" Background="#1F4B6E" CornerRadius="5" Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}"><TextBlock Foreground="White" Text="Procesando…"/></Border>
        </Grid>

        <Grid Grid.Row="1" Margin="28" DataContext="{Binding Asistencia}"
              Visibility="{Binding DataContext.MostrarAsistenciaDiaria, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings><KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarCommand}"/></Grid.InputBindings>
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="Asistencia" Foreground="#52606D"/><TextBlock Text="Registro diario" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vista mensual" Command="{Binding DataContext.MostrarVistaMensualCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><StackPanel><TextBlock Text="Fecha" FontWeight="SemiBold"/><DatePicker Width="170" SelectedDate="{Binding FechaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="14" Background="White" CornerRadius="7">
                <DockPanel><TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="{Binding EstadoGuardado}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Margin="12,0" Text="{Binding Total, StringFormat=Total: {0}}"/><TextBlock Margin="12,0" Text="{Binding Presentes, StringFormat=Presentes: {0}}"/><TextBlock Margin="12,0" Text="{Binding Faltas, StringFormat=Faltas: {0}}"/><TextBlock Margin="12,0" Text="{Binding Retardos, StringFormat=Retardos: {0}}"/><TextBlock Margin="12,0" Text="{Binding Justificadas, StringFormat=Falta justificada: {0}}"/></StackPanel></DockPanel>
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Estudiantes}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal" FontSize="15" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Estado" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Margin="4" ItemsSource="{Binding OpcionesEstado}" DisplayMemberPath="Texto" SelectedValuePath="Estado" SelectedValue="{Binding Estado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Situación actual" Binding="{Binding SituacionActual}" Width="180" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="Marcar todos presentes" Command="{Binding MarcarTodosPresentesCommand}"/><Button DockPanel.Dock="Right" Content="Guardar (Ctrl+S)" Command="{Binding GuardarCommand}"/></DockPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20" DataContext="{Binding AsistenciaMensual}"
              Visibility="{Binding DataContext.MostrarAsistenciaMensual, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="Asistencia" Foreground="#52606D"/><TextBlock Text="Vista mensual" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Vista diaria" Command="{Binding DataContext.MostrarVistaDiariaCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="&lt;" Command="{Binding MesAnteriorCommand}" MinWidth="42"/>
                    <ComboBox Width="135" Margin="4" ItemsSource="{Binding Meses}" DisplayMemberPath="Nombre" SelectedValuePath="Numero" SelectedValue="{Binding MesSeleccionado}"/>
                    <TextBox Width="78" Margin="4" Text="{Binding AnioSeleccionado, UpdateSourceTrigger=LostFocus}"/>
                    <Button Content="&gt;" Command="{Binding MesSiguienteCommand}" MinWidth="42"/>
                    <Button Content="Mes actual" Command="{Binding IrMesActualCommand}"/>
                </StackPanel>
            </DockPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <Border Background="White" Padding="12,8" Margin="0,0,8,0"><TextBlock Text="{Binding EstadoMes}" FontWeight="SemiBold"/></Border>
                <Border Background="White" Padding="12,8" Margin="0,0,8,0"><TextBlock Text="{Binding AlumnosVisibles, StringFormat=Alumnos: {0}}"/></Border>
                <Border Background="White" Padding="12,8" Margin="0,0,8,0"><TextBlock Text="{Binding DiasGuardados, StringFormat=Días guardados: {0}}"/></Border>
                <Border Background="#FFF4CE" Padding="12,8"><TextBlock Text="Los conteos incluyen borradores" Visibility="{Binding IncluyeBorradores, Converter={StaticResource BoolToVisibility}}"/></Border>
            </WrapPanel>
            <DockPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBox DockPanel.Dock="Left" Width="260" Margin="0" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estudiante"/>
                <ComboBox DockPanel.Dock="Left" Width="220" Margin="8,0" ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding FechaSeleccionadaTexto}" FontWeight="SemiBold"/>
            </DockPanel>
            <DataGrid x:Name="GrillaMensual" Grid.Row="3" ItemsSource="{Binding FilasVisibles}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" IsReadOnly="True"
                      FrozenColumnCount="2" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="All"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="30"
                      SelectionUnit="Cell" SelectionMode="Single" CurrentCellChanged="OnCeldaMensualSeleccionada"
                      MouseDoubleClick="OnCeldaMensualDobleClic" PreviewKeyDown="OnGrillaMensualPreviewKeyDown"/>
            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Marcar día presente" Command="{Binding MarcarDiaPresenteCommand}"/>
                    <Button Content="Descartar día" Command="{Binding DescartarDiaCommand}"/>
                    <Button Content="Descartar mes" Command="{Binding DescartarMesCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="8" Text="P Presente · F Falta · R Retardo · J Justificada"/>
                    <Button Content="Guardar día" Command="{Binding GuardarDiaCommand}"/>
                    <Button Content="Guardar cambios (Ctrl+S)" Command="{Binding GuardarMesCommand}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- VISTA DE PROYECTOS (Rediseñada) -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" DataContext="{Binding Proyectos}"
              Visibility="{Binding DataContext.MostrarProyectos, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Barra de herramientas superior -->
            <Border Grid.Row="0" Background="White" Padding="20,16" CornerRadius="10,10,0,0" Margin="20,20,20,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Proyectos Didácticos" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Gestiona tus proyectos y actividades de aprendizaje" 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Width="280" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0"
                                 Text="{Binding BusquedaActividad, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar actividad por nombre">
                            <TextBox.InputBindings>
                                <KeyBinding Key="F3" Command="{Binding DataContext.IrAProyectosCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <ComboBox Width="180" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0"
                                  ItemsSource="{Binding FiltrosProyecto}" SelectedItem="{Binding FiltroProyecto}"
                                  ToolTip="Filtrar proyectos por estado"/>
                        <Button Content="Nuevo Proyecto" Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding NuevoProyectoCommand}" ToolTip="Crear un nuevo proyecto didáctico"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            
            <!-- Área principal con 3 columnas -->
            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="240" MaxWidth="350"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>
                
                <!-- COLUMNA 1: Lista de Proyectos -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Mis Proyectos" Style="{StaticResource SectionTitleStyle}"/>
                        
                        <!-- Contador de proyectos -->
                        <Border Grid.Row="1" Background="#F8FAFC" Padding="12,8" CornerRadius="6" Margin="0,0,0,12">
                            <TextBlock Text="{Binding ProyectosVisibles.Count, StringFormat={}{0} proyectos}" 
                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- Lista de proyectos -->
                        <ListBox Grid.Row="2" Style="{StaticResource ModernListBoxStyle}"
                                 ItemsSource="{Binding ProyectosVisibles}" 
                                 SelectedItem="{Binding ProyectoSeleccionado}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="-12,-10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" 
                                                       TextWrapping="Wrap" FontSize="14" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <!-- Badge de estado con color -->
                                                <Border CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Borrador">
                                                                    <Setter Property="Background" Value="#ECEFF2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Estado}" Value="EnCurso">
                                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Borrador">
                                                                    <Setter Property="Background" Value="#ECEFF2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Estado}" Value="EnCurso">
                                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="Borrador">
                                                                        <Setter Property="Foreground" Value="#5D6670"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="EnCurso">
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}">
                                                                <Binding Path="Estado"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding FechaInicio, StringFormat={}{0:dd/MM}}" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                
                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" 
                              Background="Transparent" BorderBrush="{StaticResource BorderLightBrush}"
                              BorderThickness="1,0,0,0"/>
                
                <!-- COLUMNA 2: Detalles del Proyecto -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <StackPanel>
                            <TextBlock Text="Detalles del Proyecto" Style="{StaticResource SectionTitleStyle}"/>
                            
                            <!-- Estado del proyecto -->
                            <Border x:Name="EstadoProyectoBadge" Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProyectoSeleccionado.Estado}" Value="Borrador">
                                                <Setter Property="Background" Value="#ECEFF2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProyectoSeleccionado.Estado}" Value="EnCurso">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProyectoSeleccionado.Estado}" Value="Finalizado">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProyectoSeleccionado.Estado}" Value="Borrador">
                                                        <Setter Property="Foreground" Value="#5D6670"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProyectoSeleccionado.Estado}" Value="EnCurso">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProyectoSeleccionado.Estado}" Value="Finalizado">
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="Estado: "/>
                                        <Run Text="{Binding ProyectoSeleccionado.Estado}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- Campos del formulario -->
                            <TextBlock Text="Nombre del proyecto" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding NombreProyecto, UpdateSourceTrigger=PropertyChanged}"/>
                            
                            <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding DescripcionProyecto, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                            
                            <!-- Fechas con DatePicker -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Fecha de inicio" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker Style="{StaticResource ModernDatePickerStyle}" 
                                                SelectedDate="{Binding FechaInicio, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fecha de término" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker Style="{StaticResource ModernDatePickerStyle}" 
                                                SelectedDate="{Binding FechaTermino, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Advertencia de duración -->
                            <Border Background="#FFF8E1" Padding="12,10" CornerRadius="6" Margin="0,4,0,12"
                                    Visibility="{Binding DuracionAtipica, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Duración fuera de 14–31 días. Puedes guardar." 
                                               Foreground="#F57C00" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Text="Observaciones" Style="{StaticResource LabelStyle}"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding ObservacionesProyecto, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
                            
                            <!-- Botones de acción del proyecto -->
                            <Separator Margin="0,16"/>
                            <TextBlock Text="Acciones" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
                            
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding GuardarProyectoCommand}" 
                                        ToolTip="Guardar cambios del proyecto"/>
                                <Button Content="Iniciar" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding IniciarProyectoCommand}"
                                        ToolTip="Iniciar proyecto (cambia a En Curso)"/>
                                <Button Content="Finalizar" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding FinalizarProyectoCommand}"
                                        ToolTip="Finalizar proyecto"/>
                                <Button Content="Reabrir" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding ReabrirProyectoCommand}"
                                        ToolTip="Reabrir proyecto finalizado"/>
                                <Button Content="Eliminar" Style="{StaticResource DangerButtonStyle}" 
                                        Command="{Binding EliminarProyectoCommand}"
                                        ToolTip="Eliminar proyecto borrador"/>
                            </WrapPanel>
                            
                            <!-- Sección de Actividades -->
                            <Separator Margin="0,20"/>
                            <DockPanel Margin="0,8,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Actividades" Style="{StaticResource SectionTitleStyle}"/>
                                <Button DockPanel.Dock="Right" Content="+ Nueva" Style="{StaticResource IconButtonStyle}" 
                                        Command="{Binding NuevaActividadCommand}" FontSize="13" Padding="10,6"
                                        ToolTip="Crear nueva actividad"/>
                            </DockPanel>
                            
                            <!-- Lista de actividades -->
                            <ListBox Height="200" Style="{StaticResource ModernListBoxStyle}"
                                     ItemsSource="{Binding Actividades}" 
                                     SelectedItem="{Binding ActividadSeleccionada}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="-10,-8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" 
                                                           TextWrapping="Wrap" FontSize="13"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding FechaRealizacion, StringFormat={}{0:dd/MM/yyyy}}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                    <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,0"/>
                                                    <TextBlock FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="Activa">
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Estado}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- GridSplitter -->
                <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" 
                              Background="Transparent" BorderBrush="{StaticResource BorderLightBrush}"
                              BorderThickness="1,0,0,0"/>
                
                <!-- COLUMNA 3: Entregas de Actividades -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Encabezado -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Entregas de Actividad" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock DockPanel.Dock="Right" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActividadSeleccionada.Estado}" Value="Activa">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActividadSeleccionada.Estado}" Value="Anulada">
                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding ActividadSeleccionada.Estado}"/>
                            </TextBlock>
                        </DockPanel>
                        
                        <!-- Campos de actividad -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Título de actividad" Style="{StaticResource LabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                         Text="{Binding TituloActividad, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha" Style="{StaticResource LabelStyle}"/>
                                <DatePicker Style="{StaticResource ModernDatePickerStyle}" 
                                            SelectedDate="{Binding FechaActividad, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Filtros y estadísticas -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,12">
                            <ComboBox DockPanel.Dock="Left" Width="160" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0"
                                      ItemsSource="{Binding FiltrosEntrega}" SelectedItem="{Binding FiltroEntrega}"
                                      ToolTip="Filtrar entregas por estado"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="#E8F5E9" Padding="10,6" CornerRadius="4" Margin="0,0,6,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32">
                                        <Run Text="✓ "/><Run Text="{Binding Entregadas, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#FFF8E1" Padding="10,6" CornerRadius="4" Margin="0,0,6,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F57C00">
                                        <Run Text="⏳ "/><Run Text="{Binding Pendientes, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#FFEBEE" Padding="10,6" CornerRadius="4">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#D32F2F">
                                        <Run Text="✗ "/><Run Text="{Binding NoEntregadas, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- DataGrid de entregas -->
                        <DataGrid x:Name="GrillaEntregas" Grid.Row="3" Style="{StaticResource ModernDataGridStyle}"
                                  ItemsSource="{Binding EntregasVisibles}" 
                                  ScrollViewer.CanContentScroll="True"
                                  EnableRowVirtualization="True"
                                  PreviewKeyDown="OnGrillaEntregasPreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding Seleccionada}" Width="40"/>
                                <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="55"/>
                                <DataGridTextColumn Header="Estudiante" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- Botones de acción de entregas -->
                        <DockPanel Grid.Row="4" Margin="0,16,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="Marcar Entregada" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding MarcarEntregadaCommand}" FontSize="13" Padding="12,8"
                                        ToolTip="Marcar seleccionadas como entregadas (E)"/>
                                <Button Content="No Entregada" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding MarcarNoEntregadaCommand}" FontSize="13" Padding="12,8"
                                        ToolTip="Marcar seleccionadas como no entregadas (N)"/>
                                <Button Content="Pendiente" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding MarcarPendienteCommand}" FontSize="13" Padding="12,8"
                                        ToolTip="Marcar seleccionadas como pendientes (P)"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding GuardarActividadCommand}" FontSize="13" Padding="12,8"
                                        ToolTip="Guardar actividad y entregas (Ctrl+S)"/>
                                <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding AnularActividadCommand}" FontSize="13" Padding="12,8"
                                        ToolTip="Anular actividad"/>
                                <Button Content="Eliminar" Style="{StaticResource DangerButtonStyle}" 
                                        Command="{Binding EliminarActividadCommand}" FontSize="13" Padding="12,8"
                                        ToolTip="Eliminar actividad"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Overlay de carga -->
            <Grid Grid.RowSpan="2" Panel.ZIndex="100" Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Fill="#80FFFFFF"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,12"/>
                    <TextBlock Text="Procesando..." FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            
            <!-- Atajo de teclado -->
            <Grid.InputBindings>
                <KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarActividadCommand}"/>
            </Grid.InputBindings>
        </Grid>
    </Grid>
</Window>
