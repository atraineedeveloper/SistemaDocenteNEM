<Window x:Class="SistemaDocente.App.Wpf.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:views="clr-namespace:SistemaDocente.App.Wpf.Views"
        xml:lang="es-MX"
        Title="{Binding TituloVentana}" Height="800" Width="1320" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:MainNavigationHeader Grid.Row="0"/>

        <Grid Grid.Row="1">
            <views:InicioGruposView
                DataContext="{Binding DataContext, ElementName=RootWindow}"
                Visibility="{Binding DataContext.MostrarInicio, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>

            <views:GrupoView
                DataContext="{Binding DataContext.Grupo, ElementName=RootWindow}"
                Expediente="{Binding DataContext.Expediente, ElementName=RootWindow}"
                Configuracion="{Binding ConfiguracionGrupo, ElementName=RootWindow}"
                Visibility="{Binding DataContext.MostrarGrupo, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>

            <views:AsistenciaView
                DataContext="{Binding DataContext.ModuloAsistencia, ElementName=RootWindow}"
                Visibility="{Binding DataContext.MostrarAsistencia, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>

            <views:ProyectosView
                DataContext="{Binding DataContext.Proyectos, ElementName=RootWindow}"
                Visibility="{Binding DataContext.MostrarProyectos, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>

            <views:EvaluacionView
                DataContext="{Binding DataContext.Evaluacion, ElementName=RootWindow}"
                Visibility="{Binding DataContext.MostrarEvaluacion, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>

            <views:ReportesView
                DataContext="{Binding DataContext.Reportes, ElementName=RootWindow}"
                Configuracion="{Binding ConfiguracionGrupo, ElementName=RootWindow}"
                Visibility="{Binding DataContext.MostrarReportes, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <Border x:Name="ToastBanner" Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,84,20,0" Padding="16,12"
                CornerRadius="8" MinWidth="260" MaxWidth="360"
                Visibility="Collapsed" Panel.ZIndex="9999"
                BorderThickness="1"
                AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="Bold" Style="{StaticResource SectionSubtitle}"/>
                    <TextBlock x:Name="ToastMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" Opacity="0.85"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True"
                     VerticalAlignment="Top"
                     Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="100"
                     Foreground="{DynamicResource PrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="Indicador de progreso"/>
    </Grid>
</Window>