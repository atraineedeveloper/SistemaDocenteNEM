<Window x:Class="SistemaDocente.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema Docente Local" Height="740" Width="1060" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="110"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    </Window.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ══ HEADER PRINCIPAL CON BRANDING + NAVEGACIÓN ══ -->
        <Border Grid.Row="0" Background="#173F5F"
                Visibility="{Binding MostrarNavegacion, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Branding -->
                    <ColumnDefinition Width="*"/>      <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>   <!-- Grupo selector -->
                    <ColumnDefinition Width="Auto"/>   <!-- Nav tabs -->
                </Grid.ColumnDefinitions>

                <!-- Columna 0: Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10">
                    <Border Background="#FFFFFF22" CornerRadius="8" Padding="9,7" Margin="0,0,12,0">
                        <TextBlock Text="📚" FontSize="20" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sistema Docente Local" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Gestión de Aula" Foreground="#78A9C8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Columna 2: Selector de grupo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            DataContext="{Binding Grupo}" Margin="0,10,16,10">
                    <TextBlock Text="Grupo:" Foreground="#78A9C8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox Width="175" VerticalAlignment="Center" Margin="0,0,8,0"
                              ItemsSource="{Binding GruposDisponibles}"
                              SelectedItem="{Binding GrupoSeleccionadoCombo, Mode=TwoWay}"
                              DisplayMemberPath="NombreGrupo"/>
                    <Button Style="{StaticResource HeaderButton}" Content="+ Nuevo" Command="{Binding AbrirNuevoGrupoCommand}" MinWidth="75"/>
                </StackPanel>

                <!-- Columna 3: Pestañas de navegación con indicador activo -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button x:Name="NavBtnGrupo" Style="{StaticResource NavTabButton}" Content="🏫 Grupo" Command="{Binding IrAGrupoCommand}" TabIndex="1"/>
                    <Button x:Name="NavBtnAsistencia" Style="{StaticResource NavTabButton}" Content="📋 Asistencia" Command="{Binding IrAAsistenciaCommand}" TabIndex="2"/>
                    <Button x:Name="NavBtnProyectos" Style="{StaticResource NavTabButton}" Content="📁 Proyectos" Command="{Binding IrAProyectosCommand}" TabIndex="3"/>
                    <Button x:Name="NavBtnEvaluacion" Style="{StaticResource NavTabButton}" Content="⭐ Evaluación" Command="{Binding IrAEvaluacionCommand}" TabIndex="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast de notificaciones (overlay) -->
        <Border x:Name="ToastBanner" Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,72,20,0" Padding="16,12"
                CornerRadius="8" MinWidth="260" MaxWidth="360"
                Visibility="Collapsed" Panel.ZIndex="9999"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="ToastMessage" FontSize="12" TextWrapping="Wrap" Opacity="0.85"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" DataContext="{Binding Grupo}"
              Visibility="{Binding DataContext.MostrarGrupo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28">
                    <Grid Visibility="{Binding MostrarBienvenida, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="1" MaxWidth="620" Padding="36" Background="White" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Bienvenido a Sistema Docente Local" FontSize="28" Foreground="#101828" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,22" Foreground="#344054" TextWrapping="Wrap" Text="Comienza escribiendo el nombre del grupo que administras."/>
                                <TextBlock Text="Nombre del grupo" Foreground="#101828" FontWeight="SemiBold"/>
                                <TextBox x:Name="NombreGrupoInicial" TabIndex="10" Text="{Binding NombreNuevoGrupo, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding CrearGrupoCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="{Binding MensajeEdicion}"/>
                                <WrapPanel><Button TabIndex="11" Content="_Crear grupo" IsDefault="True" Command="{Binding CrearGrupoCommand}"/><Button TabIndex="12" Content="_Olvidar referencia" Command="{Binding OlvidarReferenciaCommand}"/></WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Visibility="{Binding MostrarGestion, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <!-- Encabezado de la vista de grupo -->
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Lista de Estudiantes" Style="{StaticResource SectionSubtitle}"/>
                                <TextBlock Text="{Binding NombreGrupo}" Style="{StaticResource Heading1}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    TabIndex="20" Content="✏️ Cambiar nombre" Command="{Binding AbrirCambioNombreCommand}"/>
                        </DockPanel>

                        <!-- DataGrid de estudiantes con virtualización -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Estudiantes}" SelectedItem="{Binding EstudianteSeleccionado}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" TabIndex="30"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                  FontSize="14" MinHeight="220"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingStackPanel.IsVirtualizing="True">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding EstaActivo}" Value="False"><Setter Property="Foreground" Value="#475467"/><Setter Property="Background" Value="#F2F4F7"/><Setter Property="FontStyle" Value="Italic"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📁 Ver Expediente" Click="OnVerExpedienteEstudianteClic"/>
                                    <MenuItem Header="✏️ Editar estudiante" Command="{Binding AbrirEditarEstudianteCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="🚫 Desactivar" Command="{Binding DesactivarEstudianteCommand}"/>
                                    <MenuItem Header="🔄 Reactivar" Command="{Binding ReactivarEstudianteCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="65"/>
                                <DataGridTextColumn Header="Nombre del Estudiante" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Género" Binding="{Binding GeneroTexto}" Width="115"/>
                                <DataGridTextColumn Header="Edad" Binding="{Binding Edad}" Width="65"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Barra de herramientas con acciones individuales y masivas -->
                        <WrapPanel Grid.Row="2" Margin="0,12,0,6">
                            <Button TabIndex="40" Content="📁 Ver Expediente" Click="OnVerExpedienteEstudianteClic"/>
                            <Button TabIndex="41" Content="➕ Agregar estudiante" Command="{Binding AbrirAgregarEstudianteCommand}"/>
                            <Button TabIndex="42" Content="✏️ Editar estudiante" Command="{Binding AbrirEditarEstudianteCommand}"/>

                            <!-- Separador visual -->
                            <Border Width="1" Height="22" Background="#D0D5DD" Margin="6,0" VerticalAlignment="Center"/>

                            <!-- Menú de acciones masivas -->
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Padding="12,7" Cursor="Hand">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Acciones masivas ▾" FontWeight="SemiBold" FontSize="13" Foreground="#344054" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Header="🚫 Desactivar seleccionado" Command="{Binding DesactivarEstudianteCommand}"/>
                                    <MenuItem Header="🔄 Reactivar seleccionado" Command="{Binding ReactivarEstudianteCommand}"/>
                                </MenuItem>
                            </Menu>
                        </WrapPanel>
                        <!-- Editor: Cambiar nombre del grupo -->
                        <Border Grid.Row="3" Style="{StaticResource ContentCard}" Visibility="{Binding MostrarEditorGrupo, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Cambiar nombre del grupo" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
                                <TextBlock Text="Nuevo nombre" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="NombreGrupoEdicion" TabIndex="50" Text="{Binding NombreEdicionGrupo, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarNombreGrupoCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Foreground="#B42318" Text="{Binding MensajeEdicion}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" TabIndex="51" Content="💾 Guardar nombre" Command="{Binding GuardarNombreGrupoCommand}"/>
                                    <Button TabIndex="52" Content="Cancelar" Command="{Binding CancelarEdicionCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Editor: Agregar / Editar estudiante con secciones -->
                        <Border Grid.Row="3" Style="{StaticResource ContentCard}" Visibility="{Binding MostrarEditorEstudiante, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TituloEditorEstudiante}" Style="{StaticResource Heading2}" Margin="0,0,0,14"/>

                                <!-- Sección: Datos Personales -->
                                <TextBlock Text="Datos Personales" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Primer apellido *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="PrimerApellidoEdicion" TabIndex="60" Text="{Binding PrimerApellidoEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Segundo apellido" Style="{StaticResource FormLabel}"/>
                                            <TextBox TabIndex="61" Text="{Binding SegundoApellidoEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Nombres *" Style="{StaticResource FormLabel}"/>
                                            <TextBox TabIndex="62" Text="{Binding NombresEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Sección: Datos Escolares -->
                                <TextBlock Text="Datos Escolares" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Número de lista *" Style="{StaticResource FormLabel}"/>
                                            <TextBox TabIndex="63" Text="{Binding NumeroListaEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Género *" Style="{StaticResource FormLabel}"/>
                                            <ComboBox TabIndex="64" SelectedIndex="{Binding GeneroIndexEdicion, Mode=TwoWay}">
                                                <ComboBoxItem Content="No especificado"/>
                                                <ComboBoxItem Content="Hombre"/>
                                                <ComboBoxItem Content="Mujer"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Fecha de nacimiento *" Style="{StaticResource FormLabel}"/>
                                            <DatePicker TabIndex="65" SelectedDate="{Binding FechaNacimientoEdicion, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Observaciones -->
                                <TextBlock Text="Observaciones particulares" Style="{StaticResource FormLabel}"/>
                                <TextBox TabIndex="66" Text="{Binding ObservacionesEdicion, UpdateSourceTrigger=PropertyChanged}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         ToolTip="Registro cualitativo y pedagógico del estudiante"/>

                                <TextBlock Foreground="#B42318" Text="{Binding MensajeEdicion}" Margin="0,6,0,4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" TabIndex="67" Content="💾 Guardar estudiante" Command="{Binding GuardarEstudianteCommand}"/>
                                    <Button TabIndex="68" Content="Cancelar" Command="{Binding CancelarEdicionCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="18" Padding="12,7" Background="#1F4B6E" CornerRadius="5" Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}"><TextBlock Foreground="White" Text="Procesando…"/></Border>
        </Grid>

        <Grid Grid.Row="1" Margin="28" DataContext="{Binding Asistencia}"
              Visibility="{Binding DataContext.MostrarAsistenciaDiaria, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings><KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarCommand}"/></Grid.InputBindings>
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Asistencia de Estudiantes" Foreground="#475467" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="Registro diario" Foreground="#101828" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button TabIndex="100" Content="_Vista mensual" Command="{Binding DataContext.MostrarVistaMensualCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Fecha: " Foreground="#101828" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <DatePicker TabIndex="101" Width="160" SelectedDate="{Binding FechaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Margin="0,0,0,14" Padding="16,12" Background="White" CornerRadius="8" BorderBrush="#EAECF0" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Foreground="#101828" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding EstadoGuardado}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8F9FA" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#101828" FontWeight="SemiBold" Text="{Binding Total, StringFormat=Total: {0}}"/></Border>
                        <Border Background="#ECFDF3" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#027A48" FontWeight="SemiBold" Text="{Binding Presentes, StringFormat=Presentes: {0}}"/></Border>
                        <Border Background="#FEF3F2" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#B42318" FontWeight="SemiBold" Text="{Binding Faltas, StringFormat=Faltas: {0}}"/></Border>
                        <Border Background="#FFFAEB" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#B54708" FontWeight="SemiBold" Text="{Binding Retardos, StringFormat=Retardos: {0}}"/></Border>
                        <Border Background="#EFF8FF" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#175CD3" FontWeight="SemiBold" Text="{Binding Justificadas, StringFormat=Falta justificada: {0}}"/></Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Estudiantes}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal" FontSize="15" EnableRowVirtualization="True" TabIndex="102">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✔️ Marcar Presente" Command="{Binding MarcarTodosPresentesCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Estado" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Margin="4" ItemsSource="{Binding OpcionesEstado}" DisplayMemberPath="Texto" SelectedValuePath="Estado" SelectedValue="{Binding Estado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Situación actual" Binding="{Binding SituacionActual}" Width="180" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <Button TabIndex="103" DockPanel.Dock="Left" Content="Marcar _todos presentes" Command="{Binding MarcarTodosPresentesCommand}"/>
                <Button TabIndex="104" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="_Guardar (Ctrl+S)" Command="{Binding GuardarCommand}"/>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24" DataContext="{Binding AsistenciaMensual}"
              Visibility="{Binding DataContext.MostrarAsistenciaMensual, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- ENCABEZADO Y CONTROLES DE FECHA REDISEÑADOS -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Asistencia del Grupo" Foreground="#475467" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="Vista mensual" Foreground="#101828" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,12,0" BorderBrush="#D0D5DD" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button TabIndex="201" Content="◄" Command="{Binding MesAnteriorCommand}" MinWidth="32" Padding="6,4" Margin="2,0"/>
                            <ComboBox TabIndex="202" Width="130" Margin="2,0" ItemsSource="{Binding Meses}" DisplayMemberPath="Nombre" SelectedValuePath="Numero" SelectedValue="{Binding MesSeleccionado}"/>
                            <TextBox TabIndex="203" Width="70" Margin="2,0" Text="{Binding AnioSeleccionado, UpdateSourceTrigger=LostFocus}"/>
                            <Button TabIndex="204" Content="►" Command="{Binding MesSiguienteCommand}" MinWidth="32" Padding="6,4" Margin="2,0"/>
                            <Button TabIndex="205" Content="Hoy" Command="{Binding IrMesActualCommand}" Margin="6,0,2,0"/>
                        </StackPanel>
                    </Border>
                    <Button TabIndex="200" Style="{StaticResource PrimaryButton}" Content="📅 Vista diaria" Command="{Binding DataContext.MostrarVistaDiariaCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </DockPanel>

            <!-- TARJETAS MÉTRICAS DEL MES — número grande + etiqueta -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- Estado del mes -->
                <Border Background="White" Padding="14,10" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#EAECF0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Estado" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <TextBlock Foreground="#101828" Text="{Binding EstadoMes}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Border>
                <!-- Alumnos -->
                <Border Background="#EFF8FF" Padding="14,10" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#B2DDFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Alumnos" Foreground="#64748B" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Foreground="#175CD3" Text="{Binding AlumnosVisibles}" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>
                <!-- Días guardados -->
                <Border Background="#ECFDF3" Padding="14,10" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#ABEFC6" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Días guardados" Foreground="#64748B" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Foreground="#027A48" Text="{Binding DiasGuardados}" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>
                <!-- Borradores pendientes -->
                <Border Background="#FFFAEB" Padding="14,10" CornerRadius="8" BorderBrush="#FEF0C7" BorderThickness="1"
                        Visibility="{Binding IncluyeBorradores, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="#B54708" FontWeight="Bold" Text="Borradores pendientes" FontSize="13"/>
                            <TextBlock Foreground="#B54708" FontSize="11" Text="Los conteos incluyen días sin guardar"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- BARRA DE BÚSQUEDA Y FILTRO -->
            <DockPanel Grid.Row="2" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBox TabIndex="210" Width="260" Margin="0,0,10,0" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estudiante por nombre..."/>
                    <ComboBox TabIndex="211" Width="200" ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="White" CornerRadius="6" Padding="12,6" BorderBrush="#EAECF0" BorderThickness="1">
                    <TextBlock VerticalAlignment="Center" Foreground="#101828" Text="{Binding FechaSeleccionadaTexto}" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>

            <DataGrid x:Name="GrillaMensual" Grid.Row="3" ItemsSource="{Binding FilasVisibles}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" IsReadOnly="True"
                      FrozenColumnCount="2" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="All"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="32"
                      SelectionUnit="Cell" SelectionMode="Single" CurrentCellChanged="OnCeldaMensualSeleccionada"
                      MouseDoubleClick="OnCeldaMensualDobleClic" PreviewKeyDown="OnGrillaMensualPreviewKeyDown" TabIndex="212">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✔️ Marcar día presente" Command="{Binding MarcarDiaPresenteCommand}"/>
                        <MenuItem Header="💾 Guardar día" Command="{Binding GuardarDiaCommand}"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Descartar día" Command="{Binding DescartarDiaCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button TabIndex="220" Content="_Marcar día presente" Command="{Binding MarcarDiaPresenteCommand}"/>
                    <Button TabIndex="221" Content="_Descartar día" Command="{Binding DescartarDiaCommand}"/>
                    <Button TabIndex="222" Content="D_escartar mes" Command="{Binding DescartarMesCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" BorderBrush="#EAECF0" BorderThickness="1">
                        <TextBlock VerticalAlignment="Center" Foreground="#475467" FontSize="13" Text="P Presente · F Falta · R Retardo · J Justificada"/>
                    </Border>
                    <Button TabIndex="223" Content="_Guardar día" Command="{Binding GuardarDiaCommand}" Margin="0,0,6,0"/>
                    <Button TabIndex="224" Style="{StaticResource PrimaryButton}" Content="G_uardar cambios (Ctrl+S)" Command="{Binding GuardarMesCommand}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- VISTA: PROYECTOS (Gestión y Planeación) -->
        <Grid Grid.Row="1" Margin="28" DataContext="{Binding Proyectos}"
              Visibility="{Binding DataContext.MostrarProyectos, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Planeación Didáctica" Foreground="#475467" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="Proyectos Didácticos" Foreground="#101828" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="+ Nuevo Proyecto" Command="{Binding NuevoProyectoCommand}"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="12,8" BorderBrush="#EAECF0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filtrar por estado: " Foreground="#101828" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ComboBox Width="180" ItemsSource="{Binding FiltrosProyecto}" SelectedItem="{Binding FiltroProyecto}"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <DataGrid x:Name="GrillaProyectosPrincipal" Grid.Row="2" ItemsSource="{Binding ProyectosVisibles}" SelectedItem="{Binding ProyectoSeleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" FontSize="14" MouseDoubleClick="OnAbrirDetalleProyectoClic"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📂 Ver / Editar Detalle del Proyecto" Click="OnAbrirDetalleProyectoClic"/>
                        <Separator/>
                        <MenuItem Header="✨ Nuevo Proyecto" Command="{Binding NuevoProyectoCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre del Proyecto" Binding="{Binding Nombre}" Width="2*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/>
                    <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Término" Binding="{Binding FechaTermino, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Actividades" Binding="{Binding NumeroActividades}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <WrapPanel DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryButton}" Content="📂 Ver / Editar Detalle del Proyecto" Click="OnAbrirDetalleProyectoClic"/>
                </WrapPanel>
            </DockPanel>
        </Grid>

        <!-- VISTA: EVALUACIÓN NEM (Pantalla Completa en Aula) -->
        <Grid Grid.Row="1" Margin="28" DataContext="{Binding Evaluacion}"
              Visibility="{Binding DataContext.MostrarEvaluacion, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO PRINCIPAL -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Evaluación de Desempeño NEM" Foreground="#475467" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="Registro Pedagógico de Actividades" Foreground="#101828" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>

            <!-- TARJETA DE SELECCIÓN DE PROYECTO Y ACTIVIDAD -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#EAECF0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. Seleccionar Proyecto Didáctico" Foreground="#101828" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Proyectos}" SelectedItem="{Binding ProyectoSeleccionado}" DisplayMemberPath="Nombre"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="2. Seleccionar Actividad a Evaluar" Foreground="#101828" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Actividades}" SelectedItem="{Binding ActividadSeleccionada}" DisplayMemberPath="Titulo"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BARRA DE BÚSQUEDA Y TARJETAS MÉTRICAS DE NIVEL NEM -->
            <DockPanel Grid.Row="2" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="200" Text="{Binding BusquedaEstudiante, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estudiante..."/>
                    <ComboBox Width="160" Margin="8,0" ItemsSource="{Binding FiltrosEntrega}" SelectedItem="{Binding FiltroEntrega}"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#F8F9FA" CornerRadius="6" Padding="10,6" Margin="4,0" BorderBrush="#EAECF0" BorderThickness="1"><TextBlock Foreground="#101828" FontWeight="SemiBold"><Run Text="Total: "/><Run Text="{Binding Total, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="#F2F4F7" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#344054" FontWeight="SemiBold"><Run Text="Pend.: "/><Run Text="{Binding Pendientes, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="#ECFDF3" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#027A48" FontWeight="SemiBold"><Run Text="Domina: "/><Run Text="{Binding Domina, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="#EFF8FF" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#175CD3" FontWeight="SemiBold"><Run Text="Suficiente: "/><Run Text="{Binding Suficiente, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="#FFFAEB" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#B54708" FontWeight="SemiBold"><Run Text="En proceso: "/><Run Text="{Binding EnProceso, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="#FEF3F2" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#B42318" FontWeight="SemiBold"><Run Text="Req. apoyo: "/><Run Text="{Binding RequiereApoyo, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="#F2F4F7" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="#475467" FontWeight="SemiBold"><Run Text="No entregó: "/><Run Text="{Binding NoEntrego, Mode=OneWay}"/></TextBlock></Border>
                </WrapPanel>
            </DockPanel>

            <!-- DATAGRID DE ENTREGAS Y EVALUACIÓN DE ACTIVIDADES -->
            <DataGrid x:Name="GrillaEntregasEvaluacion" Grid.Row="3" ItemsSource="{Binding EntregasVisibles}" SelectedItem="{Binding EntregaSeleccionada, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" EnableRowVirtualization="True" PreviewKeyDown="OnGrillaEntregasEvaluacionPreviewKeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🌟 Domina (D) — Alumno seleccionado" Command="{Binding MarcarDominaCommand}"/>
                        <MenuItem Header="📘 Suficiente (S) — Alumno seleccionado" Command="{Binding MarcarSuficienteCommand}"/>
                        <MenuItem Header="📙 En proceso (E) — Alumno seleccionado" Command="{Binding MarcarEnProcesoCommand}"/>
                        <MenuItem Header="🔴 Requiere apoyo (R) — Alumno seleccionado" Command="{Binding MarcarRequiereApoyoCommand}"/>
                        <MenuItem Header="⚪ No entregó (N) — Alumno seleccionado" Command="{Binding MarcarNoEntregoCommand}"/>
                        <Separator/>
                        <MenuItem Header="⚪ Marcar pendiente (P)" Command="{Binding MarcarPendienteCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Seleccionada}" Width="45"/>
                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" IsReadOnly="True" Width="55"/>
                    <DataGridTextColumn Header="Nombre del Estudiante" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Situación" Binding="{Binding SituacionActual}" IsReadOnly="True" Width="140"/>
                    <DataGridTextColumn Header="Nivel de logro" Binding="{Binding EtiquetaNivel}" IsReadOnly="True" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="D">
                                        <Setter Property="Foreground" Value="#027A48"/>
                                        <Setter Property="Background" Value="#ECFDF3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="S">
                                        <Setter Property="Foreground" Value="#175CD3"/>
                                        <Setter Property="Background" Value="#EFF8FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="EP">
                                        <Setter Property="Foreground" Value="#B54708"/>
                                        <Setter Property="Background" Value="#FFFAEB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="RA">
                                        <Setter Property="Foreground" Value="#B42318"/>
                                        <Setter Property="Background" Value="#FEF3F2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="NE">
                                        <Setter Property="Foreground" Value="#475467"/>
                                        <Setter Property="Background" Value="#F2F4F7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Observación" Binding="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- BOTONERA DE CAPTURA RÁPIDA Y ACCIÓN PRIMARIA -->
            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Calificar alumno:" VerticalAlignment="Center" Foreground="#344054" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Button Content="D Domina" Command="{Binding MarcarDominaCommand}" MinWidth="85"/>
                    <Button Content="S Suficiente" Command="{Binding MarcarSuficienteCommand}" MinWidth="95"/>
                    <Button Content="E En proceso" Command="{Binding MarcarEnProcesoCommand}" MinWidth="100"/>
                    <Button Content="R Req. apoyo" Command="{Binding MarcarRequiereApoyoCommand}" MinWidth="100"/>
                    <Button Content="N No entregó" Command="{Binding MarcarNoEntregoCommand}" MinWidth="100"/>
                    <Button Content="P Pendiente" Command="{Binding MarcarPendienteCommand}" MinWidth="90"/>

                    <Border Width="1" Height="24" Background="#D0D5DD" Margin="10,0"/>

                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="👥 Marcar a todo el grupo ▾" Foreground="#101828" FontWeight="SemiBold">
                            <MenuItem Header="🌟 Asignar 'Domina' a todos" Command="{Binding MarcarTodosDominaCommand}"/>
                            <MenuItem Header="📘 Asignar 'Suficiente' a todos" Command="{Binding MarcarTodosSuficienteCommand}"/>
                            <MenuItem Header="📙 Asignar 'En proceso' a todos" Command="{Binding MarcarTodosEnProcesoCommand}"/>
                            <MenuItem Header="🔴 Asignar 'Requiere apoyo' a todos" Command="{Binding MarcarTodosRequiereApoyoCommand}"/>
                            <MenuItem Header="⚪ Asignar 'No entregó' a todos" Command="{Binding MarcarTodosNoEntregoCommand}"/>
                        </MenuItem>
                    </Menu>
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Descartar" Command="{Binding DescartarActividadCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Guardar cambios (Ctrl+S)" Command="{Binding GuardarActividadCommand}"/>
                </WrapPanel>
            </DockPanel>
            <Grid.InputBindings><KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarActividadCommand}"/></Grid.InputBindings>
        </Grid>
    </Grid>
</Window>
