<Window x:Class="SistemaDocente.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:prop="clr-namespace:SistemaDocente.App.Wpf.Properties"
        xml:lang="es-MX"
        Title="{Binding TituloVentana}" Height="740" Width="1060" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ══ HEADER PRINCIPAL CON BRANDING + NAVEGACIÓN ══ -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}"
                Visibility="{Binding MostrarNavegacion, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Branding -->
                    <ColumnDefinition Width="*"/>      <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>   <!-- Grupo selector -->
                    <ColumnDefinition Width="Auto"/>   <!-- Nav tabs -->
                    <ColumnDefinition Width="Auto"/>   <!-- Tema -->
                </Grid.ColumnDefinitions>

                <!-- Columna 0: Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10">
                    <Border Background="#FFFFFF22" CornerRadius="8" Padding="9,7" Margin="0,0,12,0">
                        <TextBlock Text="📚" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sistema Docente Local" Foreground="{DynamicResource TextOnPrimaryBrush}" Style="{StaticResource Heading3}" FontWeight="Bold"/>
                        <TextBlock Text="Gestión de Aula" Foreground="{DynamicResource TextOnDarkBrush}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Columna 2: Selector de grupo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            DataContext="{Binding Grupo}" Margin="0,10,16,10">
                    <TextBlock Text="Grupo:" Foreground="{DynamicResource TextOnDarkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Caption}"/>
                    <ComboBox Width="175" VerticalAlignment="Center" Margin="0,0,8,0" TabIndex="1"
                              ItemsSource="{Binding GruposDisponibles}"
                              SelectedItem="{Binding GrupoSeleccionadoCombo, Mode=TwoWay}"
                              DisplayMemberPath="NombreGrupo"
                              AutomationProperties.Name="Selector de grupo"/>
                    <Button Style="{StaticResource HeaderButton}" Content="_Nuevo" Command="{Binding AbrirNuevoGrupoCommand}" MinWidth="75" TabIndex="2"/>
                </StackPanel>

                <!-- Columna 3: Pestañas de navegación con indicador activo -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button x:Name="NavBtnGrupo" Style="{StaticResource NavTabButton}" Content="🏫 Grupo" Command="{Binding IrAGrupoCommand}" TabIndex="3" AutomationProperties.Name="Navegar a Grupo"/>
                    <Button x:Name="NavBtnAsistencia" Style="{StaticResource NavTabButton}" Content="📋 Asistencia" Command="{Binding IrAAsistenciaCommand}" TabIndex="4" AutomationProperties.Name="Navegar a Asistencia"/>
                    <Button x:Name="NavBtnProyectos" Style="{StaticResource NavTabButton}" Content="📁 Proyectos" Command="{Binding IrAProyectosCommand}" TabIndex="5" AutomationProperties.Name="Navegar a Proyectos"/>
                    <Button x:Name="NavBtnEvaluacion" Style="{StaticResource NavTabButton}" Content="⭐ Evaluación" Command="{Binding IrAEvaluacionCommand}" TabIndex="6" AutomationProperties.Name="Navegar a Evaluación"/>
                </StackPanel>

                <!-- Columna 4: Selector de tema -->
                <Menu Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" Background="Transparent">
                    <MenuItem Header="🎨 Tema" Foreground="{DynamicResource TextOnPrimaryBrush}" TabIndex="7" AutomationProperties.Name="Seleccionar tema">
                        <MenuItem Header="Claro" Click="TemaClaro_Click" AutomationProperties.Name="Tema claro"/>
                        <MenuItem Header="Oscuro" Click="TemaOscuro_Click" AutomationProperties.Name="Tema oscuro"/>
                        <MenuItem Header="Alto contraste" Click="TemaAltoContraste_Click" AutomationProperties.Name="Tema alto contraste"/>
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <!-- Toast de notificaciones (overlay) -->
        <Border x:Name="ToastBanner" Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,72,20,0" Padding="16,12"
                CornerRadius="8" MinWidth="260" MaxWidth="360"
                Visibility="Collapsed" Panel.ZIndex="9999"
                BorderThickness="1"
                AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="Bold" Style="{StaticResource SectionSubtitle}"/>
                    <TextBlock x:Name="ToastMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" Opacity="0.85"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True"
                     VerticalAlignment="Top"
                     Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="100"
                     Foreground="{DynamicResource PrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="Indicador de progreso"/>

        <Grid Grid.Row="1" DataContext="{Binding Grupo}"
              Visibility="{Binding DataContext.MostrarGrupo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="{DynamicResource MarginXXXLarge}">
                    <Grid x:Name="GrupoBienvenidaPanel" Visibility="{Binding MostrarBienvenida, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="1" MaxWidth="620" Padding="36" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Bienvenido a Sistema Docente Local" Style="{StaticResource Heading1}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,22" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="Comienza escribiendo el nombre del grupo que administras."/>
                                <controls:FormField Header="Nombre del grupo">
                                    <TextBox TabIndex="10" Text="{Binding NombreNuevoGrupo, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding CrearGrupoCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                </controls:FormField>
                                <TextBlock Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Text="{Binding MensajeEdicion}" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,6,0,0"><Button TabIndex="11" Content="_Crear grupo" IsDefault="True" Command="{Binding CrearGrupoCommand}"/><Button TabIndex="12" Content="_Olvidar referencia" Command="{Binding OlvidarReferenciaCommand}"/></WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Visibility="{Binding MostrarGestion, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <!-- Encabezado de la vista de grupo -->
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Lista de Estudiantes" Style="{StaticResource SectionSubtitle}"/>
                                <TextBlock Text="{Binding NombreGrupo}" Style="{StaticResource Heading1}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    TabIndex="20" Content="✏️ Cambiar nombre" Command="{Binding AbrirCambioNombreCommand}"/>
                        </DockPanel>

                        <!-- DataGrid de estudiantes con virtualización -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8"><TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Width="260" HorizontalAlignment="Left" TabIndex="25" AutomationProperties.Name="Buscar estudiante por nombre o numero de lista" ToolTip="Filtra por nombre o numero de lista" Text="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding EstudiantesFiltrados}" SelectedItem="{Binding EstudianteSeleccionado}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" TabIndex="30"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                      FontSize="14" MinHeight="220"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingStackPanel.IsVirtualizing="True">
                                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding EstaActivo}" Value="False"><Setter Property="Foreground" Value="#475467"/><Setter Property="Background" Value="#F2F4F7"/><Setter Property="FontStyle" Value="Italic"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📁 Ver Expediente" Click="OnVerExpedienteEstudianteClic"/>
                                        <MenuItem Header="✏️ Editar estudiante" Command="{Binding AbrirEditarEstudianteCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="🚫 Desactivar" Command="{Binding DesactivarEstudianteCommand}"/>
                                        <MenuItem Header="🔄 Reactivar" Command="{Binding ReactivarEstudianteCommand}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="65"/>
                                    <DataGridTextColumn Header="Nombre del Estudiante" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Género" Binding="{Binding GeneroTexto}" Width="115"/>
                                    <DataGridTextColumn Header="Edad" Binding="{Binding Edad}" Width="65"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <controls:EmptyState Icon="👥" Title="Aún no hay estudiantes" Message="Agrega el primer estudiante al grupo para comenzar." ActionText="_Agregar estudiante" ActionCommand="{Binding AbrirAgregarEstudianteCommand}" Visibility="{Binding Estudiantes.Count, Converter={StaticResource CountToVisibility}}"/>
                        </Grid>

                        <!-- Barra de herramientas con acciones individuales y masivas -->
                        <WrapPanel Grid.Row="2" Margin="0,12,0,6">
                            <Button TabIndex="40" Content="📁 _Ver Expediente" Click="OnVerExpedienteEstudianteClic"/>
                            <Button TabIndex="41" Content="➕ _Agregar estudiante" Command="{Binding AbrirAgregarEstudianteCommand}"/>
                            <Button TabIndex="42" Content="✏️ _Editar estudiante" Command="{Binding AbrirEditarEstudianteCommand}"/>

                            <!-- Separador visual -->
                            <Border Width="1" Height="22" Background="{DynamicResource BorderDefaultBrush}" Margin="6,0" VerticalAlignment="Center"/>

                            <!-- Menú de acciones masivas -->
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Padding="12,7" Cursor="Hand">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙️" Style="{StaticResource SectionSubtitle}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Acciones masivas ▾" FontWeight="SemiBold" Style="{StaticResource SectionSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Header="🚫 Desactivar seleccionado" Command="{Binding DesactivarEstudianteCommand}"/>
                                    <MenuItem Header="🔄 Reactivar seleccionado" Command="{Binding ReactivarEstudianteCommand}"/>
                                </MenuItem>
                            </Menu>
                        </WrapPanel>
                        <!-- Editor: Cambiar nombre del grupo -->
                        <Border x:Name="GrupoEditorPanel" Grid.Row="3" Style="{StaticResource ContentCard}" Visibility="{Binding MostrarEditorGrupo, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Cambiar nombre del grupo" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
                                <controls:FormField Header="Nuevo nombre">
                                    <TextBox TabIndex="50" Text="{Binding NombreEdicionGrupo, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarNombreGrupoCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                </controls:FormField>
                                <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding MensajeEdicion}" Margin="0,4,0,4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" TabIndex="51" Content="💾 _Guardar nombre" Command="{Binding GuardarNombreGrupoCommand}"/>
                                    <Button TabIndex="52" Content="_Cancelar" Command="{Binding CancelarEdicionCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Editor: Agregar / Editar estudiante con secciones -->
                        <Border x:Name="EstudianteEditorPanel" Grid.Row="3" Style="{StaticResource ContentCard}" Visibility="{Binding MostrarEditorEstudiante, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TituloEditorEstudiante}" Style="{StaticResource Heading2}" Margin="0,0,0,14"/>

                                <!-- Sección: Datos Personales -->
                                <TextBlock Text="Datos Personales" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:FormField Grid.Column="0" Header="Primer apellido *">
                                            <TextBox TabIndex="60" Text="{Binding PrimerApellidoEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </controls:FormField>
                                        <controls:FormField Grid.Column="2" Header="Segundo apellido">
                                            <TextBox TabIndex="61" Text="{Binding SegundoApellidoEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </controls:FormField>
                                        <controls:FormField Grid.Column="4" Header="Nombres *">
                                            <TextBox TabIndex="62" Text="{Binding NombresEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </controls:FormField>
                                    </Grid>
                                </Border>

                                <!-- Sección: Datos Escolares -->
                                <TextBlock Text="Datos Escolares" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource SectionCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:FormField Grid.Column="0" Header="Número de lista *">
                                            <TextBox TabIndex="63" Text="{Binding NumeroListaEdicion, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelarEdicionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                        </controls:FormField>
                                        <controls:FormField Grid.Column="2" Header="Género *">
                                            <ComboBox TabIndex="64" SelectedIndex="{Binding GeneroIndexEdicion, Mode=TwoWay}" AutomationProperties.Name="Género del estudiante">
                                                <ComboBoxItem Content="No especificado"/>
                                                <ComboBoxItem Content="Hombre"/>
                                                <ComboBoxItem Content="Mujer"/>
                                            </ComboBox>
                                        </controls:FormField>
                                        <controls:FormField Grid.Column="4" Header="Fecha de nacimiento *">
                                            <DatePicker TabIndex="65" SelectedDate="{Binding FechaNacimientoEdicion, Mode=TwoWay}" AutomationProperties.Name="Fecha de nacimiento del estudiante"/>
                                        </controls:FormField>
                                    </Grid>
                                </Border>

                                <!-- Observaciones -->
                                <controls:FormField Header="Observaciones particulares">
                                    <TextBox TabIndex="66" Text="{Binding ObservacionesEdicion, UpdateSourceTrigger=PropertyChanged}"
                                             Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                             ToolTip="Registro cualitativo y pedagógico del estudiante"/>
                                </controls:FormField>

                                <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding MensajeEdicion}" Margin="0,6,0,4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" TabIndex="67" Content="💾 _Guardar estudiante" Command="{Binding GuardarEstudianteCommand}"/>
                                    <Button TabIndex="68" Content="_Cancelar" Command="{Binding CancelarEdicionCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="18" Padding="12,7" Background="{DynamicResource PrimaryHoverBrush}" CornerRadius="5" Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}"><TextBlock Foreground="{DynamicResource TextOnPrimaryBrush}" Text="Procesando…"/></Border>
        </Grid>

        <Grid Grid.Row="1" Margin="{DynamicResource MarginXXXLarge}" DataContext="{Binding Asistencia}"
              Visibility="{Binding DataContext.MostrarAsistenciaDiaria, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings><KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarCommand}"/></Grid.InputBindings>
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Asistencia de Estudiantes" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource SectionSubtitle}" FontWeight="Medium"/>
                    <TextBlock Text="Registro diario" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button TabIndex="100" Content="_Vista mensual" Command="{Binding DataContext.MostrarVistaMensualCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Fecha: " Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <DatePicker TabIndex="101" Width="160" SelectedDate="{Binding FechaSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fecha de asistencia"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Margin="0,0,0,14" Padding="16,12" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding EstadoGuardado}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Total, StringFormat=Total: {0}}"/></Border>
                        <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Text="{Binding Presentes, StringFormat=Presentes: {0}}"/></Border>
                        <Border Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" Text="{Binding Faltas, StringFormat=Faltas: {0}}"/></Border>
                        <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Text="{Binding Retardos, StringFormat=Retardos: {0}}"/></Border>
                        <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" Text="{Binding Justificadas, StringFormat=Falta justificada: {0}}"/></Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Estudiantes}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" RowHeaderWidth="0" GridLinesVisibility="Horizontal" FontSize="15" EnableRowVirtualization="True" TabIndex="102">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✔️ Marcar Presente" Command="{Binding MarcarTodosPresentesCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Estado" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Margin="4" ItemsSource="{Binding OpcionesEstado}" DisplayMemberPath="Texto" SelectedValuePath="Estado" SelectedValue="{Binding Estado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Situación actual" Binding="{Binding SituacionActual}" Width="180" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <Button TabIndex="103" DockPanel.Dock="Left" Content="Marcar _todos presentes" Command="{Binding MarcarTodosPresentesCommand}"/>
                <Button TabIndex="104" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="_Guardar (Ctrl+S)" Command="{Binding GuardarCommand}"/>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24" DataContext="{Binding AsistenciaMensual}"
              Visibility="{Binding DataContext.MostrarAsistenciaMensual, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- ENCABEZADO Y CONTROLES DE FECHA REDISEÑADOS -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Asistencia del Grupo" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource SectionSubtitle}" FontWeight="Medium"/>
                    <TextBlock Text="Vista mensual" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="6,4" Margin="0,0,12,0" BorderBrush="#D0D5DD" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button TabIndex="201" Content="◄" Command="{Binding MesAnteriorCommand}" MinWidth="32" Padding="6,4" Margin="2,0"/>
                            <ComboBox TabIndex="202" Width="130" Margin="2,0" ItemsSource="{Binding Meses}" DisplayMemberPath="Nombre" SelectedValuePath="Numero" SelectedValue="{Binding MesSeleccionado}" AutomationProperties.Name="Mes de consulta"/>
                            <TextBox TabIndex="203" Width="70" Margin="2,0" Text="{Binding AnioSeleccionado, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Año de consulta"/>
                            <Button TabIndex="204" Content="►" Command="{Binding MesSiguienteCommand}" MinWidth="32" Padding="6,4" Margin="2,0"/>
                            <Button TabIndex="205" Content="Hoy" Command="{Binding IrMesActualCommand}" Margin="6,0,2,0"/>
                        </StackPanel>
                    </Border>
                    <Button TabIndex="200" Style="{StaticResource PrimaryButton}" Content="📅 Vista diaria" Command="{Binding DataContext.MostrarVistaDiariaCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </DockPanel>

            <!-- TARJETAS MÉTRICAS DEL MES — número grande + etiqueta -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- Estado del mes -->
                <Border Background="{DynamicResource CardBackgroundBrush}" Padding="14,10" Margin="0,0,10,0" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Estado" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding EstadoMes}" FontWeight="SemiBold" Style="{StaticResource Body}"/>
                    </StackPanel>
                </Border>
                <!-- Alumnos -->
                <Border Background="{DynamicResource InfoBackgroundBrush}" Padding="14,10" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#B2DDFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Alumnos" Foreground="{DynamicResource TextCaptionBrush}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{DynamicResource InfoBrush}" Text="{Binding AlumnosVisibles}" FontWeight="Bold" Style="{StaticResource Heading2}"/>
                    </StackPanel>
                </Border>
                <!-- Días guardados -->
                <Border Background="{DynamicResource SuccessBackgroundBrush}" Padding="14,10" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#ABEFC6" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Días guardados" Foreground="{DynamicResource TextCaptionBrush}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Foreground="{DynamicResource SuccessBrush}" Text="{Binding DiasGuardados}" FontWeight="Bold" Style="{StaticResource Heading2}"/>
                    </StackPanel>
                </Border>
                <!-- Borradores pendientes -->
                <Border Background="{DynamicResource WarningBackgroundBrush}" Padding="14,10" CornerRadius="8" BorderBrush="#FEF0C7" BorderThickness="1"
                        Visibility="{Binding IncluyeBorradores, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" Style="{StaticResource Body}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" Text="Borradores pendientes" Style="{StaticResource SectionSubtitle}"/>
                            <TextBlock Foreground="{DynamicResource WarningBrush}" Style="{StaticResource Caption}" Text="Los conteos incluyen días sin guardar"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- BARRA DE BÚSQUEDA Y FILTRO -->
            <DockPanel Grid.Row="2" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBox TabIndex="210" Width="260" Margin="0,0,10,0" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estudiante por nombre..." AutomationProperties.Name="Buscar estudiante"/>
                    <ComboBox TabIndex="211" Width="200" ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}" AutomationProperties.Name="Filtro de asistencia"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding FechaSeleccionadaTexto}" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>

            <DataGrid x:Name="GrillaMensual" Grid.Row="3" ItemsSource="{Binding FilasVisibles}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" IsReadOnly="True"
                      FrozenColumnCount="2" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="All"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="32"
                      SelectionUnit="Cell" SelectionMode="Single" CurrentCellChanged="OnCeldaMensualSeleccionada"
                      MouseDoubleClick="OnCeldaMensualDobleClic" PreviewKeyDown="OnGrillaMensualPreviewKeyDown" TabIndex="212">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✔️ Marcar día presente" Command="{Binding MarcarDiaPresenteCommand}"/>
                        <MenuItem Header="💾 Guardar día" Command="{Binding GuardarDiaCommand}"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Descartar día" Command="{Binding DescartarDiaCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button TabIndex="220" Content="_Marcar día presente" Command="{Binding MarcarDiaPresenteCommand}"/>
                    <Button TabIndex="221" Content="_Descartar día" Command="{Binding DescartarDiaCommand}"/>
                    <Button TabIndex="222" Content="D_escartar mes" Command="{Binding DescartarMesCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource SectionSubtitle}" Text="P Presente · F Falta · R Retardo · J Justificada"/>
                    </Border>
                    <Button TabIndex="223" Content="_Guardar día" Command="{Binding GuardarDiaCommand}" Margin="0,0,6,0"/>
                    <Button TabIndex="224" Style="{StaticResource PrimaryButton}" Content="G_uardar cambios (Ctrl+S)" Command="{Binding GuardarMesCommand}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- VISTA: PROYECTOS (Gestión y Planeación) -->
        <Grid Grid.Row="1" Margin="{DynamicResource MarginXXXLarge}" DataContext="{Binding Proyectos}"
              Visibility="{Binding DataContext.MostrarProyectos, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Planeación Didáctica" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource SectionSubtitle}" FontWeight="Medium"/>
                    <TextBlock Text="Proyectos Didácticos" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="+ _Nuevo Proyecto" Command="{Binding NuevoProyectoCommand}" TabIndex="300" AutomationProperties.Name="Crear nuevo proyecto"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <Border DockPanel.Dock="Left" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filtrar por estado: " Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ComboBox Width="180" ItemsSource="{Binding FiltrosProyecto}" SelectedItem="{Binding FiltroProyecto}" TabIndex="301" AutomationProperties.Name="Filtrar proyectos por estado"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <DataGrid x:Name="GrillaProyectosPrincipal" Grid.Row="2" ItemsSource="{Binding ProyectosVisibles}" SelectedItem="{Binding ProyectoSeleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" FontSize="14" MouseDoubleClick="OnAbrirDetalleProyectoClic"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📂 Ver / Editar Detalle del Proyecto" Click="OnAbrirDetalleProyectoClic"/>
                        <Separator/>
                        <MenuItem Header="✨ Nuevo Proyecto" Command="{Binding NuevoProyectoCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre del Proyecto" Binding="{Binding Nombre}" Width="2*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/>
                    <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Término" Binding="{Binding FechaTermino, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Actividades" Binding="{Binding NumeroActividades}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <WrapPanel DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryButton}" Content="📂 _Ver / Editar Detalle del Proyecto" Click="OnAbrirDetalleProyectoClic" TabIndex="302" AutomationProperties.Name="Ver o editar detalle del proyecto seleccionado"/>
                </WrapPanel>
            </DockPanel>
        </Grid>

        <!-- VISTA: EVALUACIÓN NEM (Pantalla Completa en Aula) -->
        <Grid Grid.Row="1" Margin="{DynamicResource MarginXXXLarge}" DataContext="{Binding Evaluacion}"
              Visibility="{Binding DataContext.MostrarEvaluacion, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding EstaOcupado}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO PRINCIPAL -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Evaluación de Desempeño NEM" Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource SectionSubtitle}" FontWeight="Medium"/>
                    <TextBlock Text="Registro Pedagógico de Actividades" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>

            <!-- TARJETA DE SELECCIÓN DE PROYECTO Y ACTIVIDAD -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. Seleccionar Proyecto Didáctico" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Proyectos}" SelectedItem="{Binding ProyectoSeleccionado}" DisplayMemberPath="Nombre" TabIndex="400" AutomationProperties.Name="Seleccionar proyecto didáctico"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="2. Seleccionar Actividad a Evaluar" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Actividades}" SelectedItem="{Binding ActividadSeleccionada}" DisplayMemberPath="Titulo" TabIndex="401" AutomationProperties.Name="Seleccionar actividad a evaluar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BARRA DE BÚSQUEDA Y TARJETAS MÉTRICAS DE NIVEL NEM -->
            <DockPanel Grid.Row="2" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="200" Text="{Binding BusquedaEstudiante, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estudiante..." TabIndex="402" AutomationProperties.Name="Buscar estudiante en evaluación"/>
                    <ComboBox Width="160" Margin="8,0" ItemsSource="{Binding FiltrosEntrega}" SelectedItem="{Binding FiltroEntrega}" TabIndex="403" AutomationProperties.Name="Filtrar por estado de entrega"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"><Run Text="Total: "/><Run Text="{Binding Total, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"><Run Text="Pend.: "/><Run Text="{Binding Pendientes, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"><Run Text="Domina: "/><Run Text="{Binding Domina, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold"><Run Text="Suficiente: "/><Run Text="{Binding Suficiente, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"><Run Text="En proceso: "/><Run Text="{Binding EnProceso, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"><Run Text="Req. apoyo: "/><Run Text="{Binding RequiereApoyo, Mode=OneWay}"/></TextBlock></Border>
                    <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="4,0"><TextBlock Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"><Run Text="No entregó: "/><Run Text="{Binding NoEntrego, Mode=OneWay}"/></TextBlock></Border>
                </WrapPanel>
            </DockPanel>

            <!-- DATAGRID DE ENTREGAS Y EVALUACIÓN DE ACTIVIDADES -->
            <DataGrid x:Name="GrillaEntregasEvaluacion" Grid.Row="3" ItemsSource="{Binding EntregasVisibles}" SelectedItem="{Binding EntregaSeleccionada, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" EnableRowVirtualization="True" PreviewKeyDown="OnGrillaEntregasEvaluacionPreviewKeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🌟 Domina (D) — Alumno seleccionado" Command="{Binding MarcarDominaCommand}"/>
                        <MenuItem Header="📘 Suficiente (S) — Alumno seleccionado" Command="{Binding MarcarSuficienteCommand}"/>
                        <MenuItem Header="📙 En proceso (E) — Alumno seleccionado" Command="{Binding MarcarEnProcesoCommand}"/>
                        <MenuItem Header="🔴 Requiere apoyo (R) — Alumno seleccionado" Command="{Binding MarcarRequiereApoyoCommand}"/>
                        <MenuItem Header="⚪ No entregó (N) — Alumno seleccionado" Command="{Binding MarcarNoEntregoCommand}"/>
                        <Separator/>
                        <MenuItem Header="⚪ Marcar pendiente (P)" Command="{Binding MarcarPendienteCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Seleccionada}" Width="45"/>
                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" IsReadOnly="True" Width="55"/>
                    <DataGridTextColumn Header="Nombre del Estudiante" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Situación" Binding="{Binding SituacionActual}" IsReadOnly="True" Width="140"/>
                    <DataGridTextColumn Header="Nivel de logro" Binding="{Binding EtiquetaNivel}" IsReadOnly="True" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="D">
                                        <Setter Property="Foreground" Value="#027A48"/>
                                        <Setter Property="Background" Value="#ECFDF3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="S">
                                        <Setter Property="Foreground" Value="#175CD3"/>
                                        <Setter Property="Background" Value="#EFF8FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="EP">
                                        <Setter Property="Foreground" Value="#B54708"/>
                                        <Setter Property="Background" Value="#FFFAEB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="RA">
                                        <Setter Property="Foreground" Value="#B42318"/>
                                        <Setter Property="Background" Value="#FEF3F2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EtiquetaNivel}" Value="NE">
                                        <Setter Property="Foreground" Value="#475467"/>
                                        <Setter Property="Background" Value="#F2F4F7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Observación" Binding="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- BOTONERA DE CAPTURA RÁPIDA Y ACCIÓN PRIMARIA -->
            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Calificar alumno:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Button Content="_D Domina" Command="{Binding MarcarDominaCommand}" MinWidth="85" TabIndex="410"/>
                    <Button Content="_S Suficiente" Command="{Binding MarcarSuficienteCommand}" MinWidth="95" TabIndex="411"/>
                    <Button Content="_E En proceso" Command="{Binding MarcarEnProcesoCommand}" MinWidth="100" TabIndex="412"/>
                    <Button Content="_R Req. apoyo" Command="{Binding MarcarRequiereApoyoCommand}" MinWidth="100" TabIndex="413"/>
                    <Button Content="_N No entregó" Command="{Binding MarcarNoEntregoCommand}" MinWidth="100" TabIndex="414"/>
                    <Button Content="_P Pendiente" Command="{Binding MarcarPendienteCommand}" MinWidth="90" TabIndex="415"/>

                    <Border Width="1" Height="24" Background="{DynamicResource BorderDefaultBrush}" Margin="10,0"/>

                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="👥 Marcar a todo el grupo ▾" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold">
                            <MenuItem Header="🌟 Asignar 'Domina' a todos" Command="{Binding MarcarTodosDominaCommand}"/>
                            <MenuItem Header="📘 Asignar 'Suficiente' a todos" Command="{Binding MarcarTodosSuficienteCommand}"/>
                            <MenuItem Header="📙 Asignar 'En proceso' a todos" Command="{Binding MarcarTodosEnProcesoCommand}"/>
                            <MenuItem Header="🔴 Asignar 'Requiere apoyo' a todos" Command="{Binding MarcarTodosRequiereApoyoCommand}"/>
                            <MenuItem Header="⚪ Asignar 'No entregó' a todos" Command="{Binding MarcarTodosNoEntregoCommand}"/>
                        </MenuItem>
                    </Menu>
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="_Descartar" Command="{Binding DescartarActividadCommand}" Margin="0,0,6,0" TabIndex="416"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="_Guardar cambios (Ctrl+S)" Command="{Binding GuardarActividadCommand}" TabIndex="417" IsDefault="True"/>
                </WrapPanel>
            </DockPanel>
            <Grid.InputBindings><KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarActividadCommand}"/></Grid.InputBindings>
        </Grid>
    </Grid>
</Window>
