<Window x:Class="SistemaDocente.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:views="clr-namespace:SistemaDocente.App.Wpf.Views"
        xml:lang="es-MX"
        Title="{Binding TituloVentana}" Height="780" Width="1280" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado global: branding + selector de grupo + navegación + tema -->
        <controls:MainNavigationHeader Grid.Row="0"/>

        <!-- Área de módulos: MainWindow sólo ensambla vistas -->
        <Grid Grid.Row="1">
            <views:GrupoView DataContext="{Binding Grupo}"
                             Expediente="{Binding Expediente}"
                             Visibility="{Binding MostrarGrupo, Converter={StaticResource BoolToVisibility}}"/>
            <views:AsistenciaView DataContext="{Binding ModuloAsistencia}"
                                  Visibility="{Binding MostrarAsistencia, Converter={StaticResource BoolToVisibility}}"/>
            <views:ProyectosView DataContext="{Binding Proyectos}"
                                 Visibility="{Binding MostrarProyectos, Converter={StaticResource BoolToVisibility}}"/>
            <views:EvaluacionView DataContext="{Binding Evaluacion}"
                                  Visibility="{Binding MostrarEvaluacion, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Toast de notificaciones (overlay global) -->
        <Border x:Name="ToastBanner" Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,72,20,0" Padding="16,12"
                CornerRadius="8" MinWidth="260" MaxWidth="360"
                Visibility="Collapsed" Panel.ZIndex="9999"
                BorderThickness="1"
                AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Direction="270"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="Bold" Style="{StaticResource SectionSubtitle}"/>
                    <TextBlock x:Name="ToastMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" Opacity="0.85"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Indicador global de progreso -->
        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True"
                     VerticalAlignment="Top"
                     Visibility="{Binding EstaOcupado, Converter={StaticResource BoolToVisibility}}"
                     Panel.ZIndex="100"
                     Foreground="{DynamicResource PrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="Indicador de progreso"/>
    </Grid>
</Window>
