<Window x:Class="SistemaDocente.App.Wpf.DetalleActividadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:prop="clr-namespace:SistemaDocente.App.Wpf.Properties"
        xml:lang="es-MX"
        Title="{x:Static prop:Resources.DetalleActividadTitle}" Height="500" Width="580" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{DynamicResource SectionBackgroundBrush}" Margin="{DynamicResource MarginXXXLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource Caption}" Margin="0,0,0,6" AutomationProperties.Name="Ruta de navegacion: Proyecto a Actividad"><TextBlock.Text><MultiBinding StringFormat="Proyecto: {0} -&gt; Actividad"><Binding Path="NombreProyecto"/><Binding Path="TituloActividad"/></MultiBinding></TextBlock.Text></TextBlock><DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Actividad de Proyecto" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TituloActividad}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" CornerRadius="16" Padding="12,5" VerticalAlignment="Center" Background="#ECFDF3" BorderBrush="#ABE5C6" BorderThickness="1">
                <TextBlock Text="{Binding ActividadSeleccionada.Estado}" FontWeight="SemiBold" Foreground="#027A48"/>
            </Border>
        </DockPanel></StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:FormField Grid.Column="0" Header="Título de la Actividad">
                            <TextBox Text="{Binding TituloActividad, UpdateSourceTrigger=PropertyChanged}" TabIndex="10" AutomationProperties.Name="Título de la actividad"/>
                        </controls:FormField>
                        <controls:FormField Grid.Column="2" Header="Fecha de Realización">
                            <DatePicker SelectedDate="{Binding FechaActividad, Mode=TwoWay}" TabIndex="11" AutomationProperties.Name="Fecha de realización de la actividad"/>
                        </controls:FormField>
                    </Grid>

                    <controls:FormField Header="Descripción">
                        <TextBox Text="{Binding DescripcionActividad, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="75" TextWrapping="Wrap" TabIndex="12" AutomationProperties.Name="Descripción de la actividad"/>
                    </controls:FormField>

                    <controls:FormField Header="Observaciones Generales">
                        <TextBox Text="{Binding ObservacionesActividad, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" TextWrapping="Wrap" TabIndex="13" AutomationProperties.Name="Observaciones generales de la actividad"/>
                    </controls:FormField>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Guardar actividad" Command="{Binding GuardarActividadCommand}" TabIndex="20" IsDefault="True"/>
                        <Button Content="Descartar cambios" Command="{Binding DescartarActividadCommand}" TabIndex="21"/>
                        <Button Content="Anular actividad" Command="{Binding AnularActividadCommand}" TabIndex="22"/>
                        <Button Content="Eliminar sin seguimiento" Command="{Binding EliminarActividadCommand}" TabIndex="23"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cerrar" Click="OnCerrarClic" IsCancel="True" MinWidth="110" TabIndex="90" AutomationProperties.Name="Cerrar ventana de actividad"/>
        </StackPanel>
    </Grid>
</Window>
