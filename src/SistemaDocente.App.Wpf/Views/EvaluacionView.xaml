<UserControl x:Class="SistemaDocente.App.Wpf.Views.EvaluacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{DynamicResource WindowBackgroundBrush}"
             xml:lang="es-MX">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarCambiosCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="EVALUACIÓN FORMATIVA" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="Registro pedagógico de actividades" Style="{StaticResource Heading1}" FontSize="28" Margin="0,3,0,3"/>
            <TextBlock Text="Selecciona un resultado por actividad. El estado de entrega se actualiza automáticamente."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,14" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="Proyecto didáctico" Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="Elige el proyecto que deseas evaluar." Style="{StaticResource Caption}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="420" Margin="0" Padding="10,8"
                          ItemsSource="{Binding Proyectos}" SelectedItem="{Binding ProyectoSeleccionado}"
                          DisplayMemberPath="Nombre" TabIndex="400"
                          AutomationProperties.Name="Seleccionar proyecto didáctico"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource ContentCard}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="ACTIVIDAD SELECCIONADA" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ContextoActividadSeleccionada}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Border Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><TextBlock><Run Text="Total "/><Run Text="{Binding Total, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><TextBlock Foreground="{DynamicResource WarningBrush}"><Run Text="Pendientes "/><Run Text="{Binding PendientesEntrega, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><TextBlock Foreground="{DynamicResource SuccessBrush}"><Run Text="Entregadas "/><Run Text="{Binding Entregadas, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Background="{DynamicResource DisabledBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><TextBlock Foreground="{DynamicResource TextMutedBrush}"><Run Text="No entregadas "/><Run Text="{Binding NoEntregadas, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><TextBlock Foreground="{DynamicResource InfoBrush}"><Run Text="Por evaluar "/><Run Text="{Binding PendientesEvaluacion, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
                <Border Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="8" Padding="10,7"><TextBlock Foreground="{DynamicResource ErrorBrush}"><Run Text="Requiere apoyo "/><Run Text="{Binding RequiereApoyo, Mode=OneWay}" FontWeight="Bold"/></TextBlock></Border>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ContentCard}" Margin="0,0,0,14" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="16"/><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0" Padding="10,8"
                         Text="{Binding BusquedaEstudiante, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar estudiante por nombre o número de lista"
                         AutomationProperties.Name="Buscar estudiante en evaluación" TabIndex="401"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mostrar" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="200" Margin="0" ItemsSource="{Binding FiltrosEntrega}" SelectedItem="{Binding FiltroEntrega}"
                              AutomationProperties.Name="Filtrar estudiantes por estado de entrega o nivel de logro" TabIndex="402"/>
                </StackPanel>
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Clic = resultado · D/S/E/R = logro · T/N/P = captura rápida"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="GrillaEvaluacionMatriz"
                      ItemsSource="{Binding FilasVisibles}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False" CanUserReorderColumns="False"
                      SelectionMode="Single" SelectionUnit="Cell"
                      FrozenColumnCount="2" HeadersVisibility="Column" RowHeaderWidth="0"
                      GridLinesVisibility="All" RowHeight="46" BorderThickness="0"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      CurrentCellChanged="OnCeldaActualCambiada"
                      PreviewKeyDown="OnGrillaEvaluacionPreviewKeyDown"
                      PreviewMouseLeftButtonUp="OnGrillaEvaluacionClick"
                      MouseDoubleClick="OnGrillaEvaluacionDobleClic"
                      TabIndex="403" AutomationProperties.Name="Matriz de evaluación por actividades">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Núm." Binding="{Binding NumeroLista}" Width="64"/>
                    <DataGridTemplateColumn Header="Estudiante" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,0,9,0">
                                        <TextBlock Text="{Binding Iniciales}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SituacionActual}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource ContentCard}" Margin="0,14,0,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="👥  Aplicar resultado al grupo ▾" FontWeight="SemiBold" Padding="10,7">
                            <MenuItem Header="Entregada · evaluar después (T)" Command="{Binding MarcarTodosEntregadaCommand}"/>
                            <MenuItem Header="Domina (D)" Command="{Binding MarcarTodosDominaCommand}"/>
                            <MenuItem Header="Suficiente (S)" Command="{Binding MarcarTodosSuficienteCommand}"/>
                            <MenuItem Header="En proceso (E)" Command="{Binding MarcarTodosEnProcesoCommand}"/>
                            <MenuItem Header="Requiere apoyo (R)" Command="{Binding MarcarTodosRequiereApoyoCommand}"/>
                            <Separator/>
                            <MenuItem Header="No entregó (N)" Command="{Binding MarcarTodosNoEntregadaCommand}"/>
                            <MenuItem Header="Pendiente (P)" Command="{Binding MarcarTodosPendienteEntregaCommand}"/>
                        </MenuItem>
                    </Menu>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0"
                               Text="La acción masiva aplica sólo a la actividad seleccionada."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Descartar" Command="{Binding DescartarCambiosCommand}" TabIndex="404"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Guardar cambios  (Ctrl+S)" Command="{Binding GuardarCambiosCommand}" TabIndex="405"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>