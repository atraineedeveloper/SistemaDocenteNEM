<UserControl x:Class="SistemaDocente.App.Wpf.Views.InicioGruposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             xml:lang="es-MX">
    <UserControl.Resources>
        <Style x:Key="GroupWorkspaceCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="MinHeight" Value="176"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="20">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1180" Margin="36,34" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ESPACIO DE TRABAJO" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Mis grupos" Style="{StaticResource Heading1}" FontSize="32" Margin="0,4,0,6"/>
                    <TextBlock Text="Selecciona el grupo con el que vas a trabajar. Asistencia, proyectos, evaluación y reportes usarán ese contexto."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="760"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Content="＋  Crear grupo"
                        Command="{Binding CrearGrupoDesdeInicioCommand}"
                        MinWidth="132"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Crear un grupo nuevo"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,24" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource InfoBackgroundBrush}" Margin="0,0,12,0">
                        <TextBlock Text="ⓘ" Foreground="{DynamicResource InfoBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Un grupo = un contexto de trabajo" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Cambiar de grupo desde el encabezado no mezcla datos y respeta los cambios pendientes de cada módulo."
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Grupo.GruposDisponibles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GroupWorkspaceCardButton}"
                                    Tag="{Binding}"
                                    Click="OnAbrirGrupoClic"
                                    AutomationProperties.Name="{Binding NombreVisible, StringFormat=Abrir grupo {0}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="👥" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NombreVisible}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Estudiantes.Count, StringFormat={}{0} estudiantes registrados}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Margin="0,18,0,18"
                                               Text="Abre la lista del grupo y continúa con asistencia, proyectos, evaluación o reportes."
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Abrir grupo" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="  →" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:EmptyState Icon="👥"
                                     Title="Aún no hay grupos"
                                     Message="Crea tu primer grupo para comenzar a trabajar con estudiantes, asistencia y evaluación."
                                     ActionText="Crear grupo"
                                     ActionCommand="{Binding CrearGrupoDesdeInicioCommand}"
                                     Visibility="{Binding Grupo.GruposDisponibles.Count, Converter={StaticResource CountToVisibility}}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>