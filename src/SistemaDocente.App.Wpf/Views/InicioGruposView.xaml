<UserControl x:Class="SistemaDocente.App.Wpf.Views.InicioGruposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="OnVistaCargada"
             xml:lang="es-MX">
    <UserControl.Resources>
        <Style x:Key="GroupWorkspaceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Width" Value="330"/>
            <Setter Property="MinHeight" Value="206"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" Margin="36,34" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ESPACIO DE TRABAJO" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Mis grupos" Style="{StaticResource Heading1}" FontSize="32" Margin="0,4,0,6"/>
                    <TextBlock Text="Abre los grupos actuales, archiva los ciclos que ya terminaste o elimina con protección los que se crearon por error."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="780"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Content="＋  Crear grupo"
                        Command="{Binding CrearGrupoDesdeInicioCommand}"
                        MinWidth="132"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Crear un grupo nuevo"/>
            </Grid>

            <Border Style="{StaticResource ContentCard}" Margin="0,0,0,24" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource InfoBackgroundBrush}" Margin="0,0,12,0">
                        <TextBlock Text="ⓘ" Foreground="{DynamicResource InfoBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Archivar conserva; eliminar borra" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Un grupo archivado conserva toda su información y puede restaurarse. La eliminación permanente exige una confirmación adicional cuando hay datos."
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Grupos activos" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>

            <Grid>
                <ItemsControl ItemsSource="{Binding Grupo.GruposDisponibles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GroupWorkspaceCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="👥" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NombreVisible}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Estudiantes.Count, StringFormat={}{0} estudiantes registrados}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Margin="0,16,0,14"
                                               Text="Asistencia, proyectos, evaluación y reportes usarán este grupo como contexto de trabajo."
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                    <Button Grid.Row="2"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Abrir grupo"
                                            HorizontalAlignment="Stretch"
                                            Tag="{Binding}"
                                            Click="OnAbrirGrupoClic"
                                            AutomationProperties.Name="{Binding NombreVisible, StringFormat=Abrir grupo {0}}"/>

                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Archivar"
                                                Margin="0,0,4,0"
                                                Tag="{Binding}"
                                                Click="OnArchivarGrupoClic"
                                                AutomationProperties.Name="{Binding NombreVisible, StringFormat=Archivar grupo {0}}"/>
                                        <Button Grid.Column="1"
                                                Content="Eliminar…"
                                                Margin="4,0,0,0"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                Tag="{Binding}"
                                                Click="OnEliminarGrupoClic"
                                                AutomationProperties.Name="{Binding NombreVisible, StringFormat=Eliminar grupo {0}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:EmptyState Icon="👥"
                                     Title="No hay grupos activos"
                                     Message="Crea un grupo nuevo o restaura uno archivado para volver a trabajar con él."
                                     ActionText="Crear grupo"
                                     ActionCommand="{Binding CrearGrupoDesdeInicioCommand}"
                                     Visibility="{Binding Grupo.GruposDisponibles.Count, Converter={StaticResource CountToVisibility}}"/>
            </Grid>

            <Border x:Name="ArchivadosPanel"
                    Margin="0,20,0,0"
                    Padding="18"
                    CornerRadius="12"
                    Background="{DynamicResource SectionBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Expander x:Name="ArchivadosExpander" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Archivados" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ArchivadosCantidadTextBlock" Margin="8,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Estos grupos conservan toda su información, pero no aparecen en los módulos de trabajo hasta que los restaures."
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="ArchivadosItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GroupWorkspaceCard}" MinHeight="176">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ARCHIVADO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding NombreVisible}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Estudiantes.Count, StringFormat={}{0} estudiantes registrados}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Margin="0,14,0,14"
                                                       Text="Restaura este grupo para volver a abrirlo y editarlo."
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Restaurar"
                                                        Margin="0,0,4,0"
                                                        Tag="{Binding}"
                                                        Click="OnRestaurarGrupoClic"
                                                        AutomationProperties.Name="{Binding NombreVisible, StringFormat=Restaurar grupo {0}}"/>
                                                <Button Grid.Column="1"
                                                        Content="Eliminar…"
                                                        Margin="4,0,0,0"
                                                        Foreground="{DynamicResource ErrorBrush}"
                                                        Tag="{Binding}"
                                                        Click="OnEliminarGrupoClic"
                                                        AutomationProperties.Name="{Binding NombreVisible, StringFormat=Eliminar grupo archivado {0}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
