<UserControl x:Class="SistemaDocente.App.Wpf.Views.CrearGrupoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             xml:lang="es-MX">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="860" Margin="40,30,40,48" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="←  Volver"
                            Command="{Binding VolverCreacionGrupoCommand}"
                            HorizontalAlignment="Left"
                            MinWidth="0"
                            Padding="10,7"
                            AutomationProperties.Name="Volver al paso anterior"/>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgresoCreacionGrupo}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TituloPasoCreacionGrupo}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Cancelar"
                            Command="{Binding CancelarCreacionGrupoCommand}"
                            MinWidth="96"
                            AutomationProperties.Name="Cancelar creación de grupo"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="34">
                    <StackPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52"
                                    CornerRadius="12"
                                    Background="{DynamicResource HoverBackgroundBrush}"
                                    Margin="0,0,16,0">
                                <TextBlock Text="👥" FontSize="23"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Crear nuevo grupo"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="Sólo el nombre del grupo es obligatorio. Puedes omitir los demás datos y completarlos después."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Paso 1: Grupo -->
                        <StackPanel Visibility="{Binding MostrarPasoGrupo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="1. Datos del grupo" Style="{StaticResource Heading2}"/>
                            <TextBlock Text="Ponle un nombre reconocible. Este es el único dato obligatorio para crear el grupo."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,18"/>
                            <controls:FormField Header="Nombre del grupo *">
                                <TextBox Text="{Binding Grupo.NombreNuevoGrupo, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="42" MaxLength="120"
                                         AutomationProperties.Name="Nombre del grupo obligatorio"/>
                            </controls:FormField>
                            <TextBlock Text="Ejemplo: 5.º B, 3.º y 4.º multigrado o Grupo vespertino"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Paso 2: Grados -->
                        <StackPanel Visibility="{Binding MostrarPasoGrados, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="2. Grados atendidos" Style="{StaticResource Heading2}"/>
                            <TextBlock Text="Selecciona uno o varios grados. Si atiendes más de uno, AulaRaíz reconocerá el grupo como multigrado. Este paso es opcional."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,18"/>
                            <WrapPanel Margin="0,0,0,14">
                                <CheckBox Content="1.º" IsChecked="{Binding ConfiguracionGrupo.PrimerGrado}" Margin="0,0,20,10" MinWidth="64"/>
                                <CheckBox Content="2.º" IsChecked="{Binding ConfiguracionGrupo.SegundoGrado}" Margin="0,0,20,10" MinWidth="64"/>
                                <CheckBox Content="3.º" IsChecked="{Binding ConfiguracionGrupo.TercerGrado}" Margin="0,0,20,10" MinWidth="64"/>
                                <CheckBox Content="4.º" IsChecked="{Binding ConfiguracionGrupo.CuartoGrado}" Margin="0,0,20,10" MinWidth="64"/>
                                <CheckBox Content="5.º" IsChecked="{Binding ConfiguracionGrupo.QuintoGrado}" Margin="0,0,20,10" MinWidth="64"/>
                                <CheckBox Content="6.º" IsChecked="{Binding ConfiguracionGrupo.SextoGrado}" Margin="0,0,20,10" MinWidth="64"/>
                            </WrapPanel>
                            <Border Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="9" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfiguracionGrupo.ModalidadGrupo}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ConfiguracionGrupo.GradosTexto}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ConfiguracionGrupo.FasesNemTexto}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Paso 3: Escuela -->
                        <StackPanel Visibility="{Binding MostrarPasoEscuela, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="3. Escuela y ciclo" Style="{StaticResource Heading2}"/>
                            <TextBlock Text="Estos datos son opcionales y se reutilizarán en reportes y configuración del grupo."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,18"/>
                            <controls:FormField Header="Nombre de la escuela (opcional)">
                                <TextBox Text="{Binding ConfiguracionGrupo.NombreEscuela, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="180" MinHeight="40"
                                         AutomationProperties.Name="Nombre opcional de la escuela"/>
                            </controls:FormField>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <controls:FormField Grid.Column="0" Header="CCT (opcional)">
                                    <TextBox Text="{Binding ConfiguracionGrupo.Cct, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="30" MinHeight="40"
                                             AutomationProperties.Name="Clave de centro de trabajo opcional"/>
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Header="Ciclo escolar (opcional)">
                                    <TextBox Text="{Binding ConfiguracionGrupo.CicloEscolar, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20" MinHeight="40"
                                             AutomationProperties.Name="Ciclo escolar opcional"/>
                                </controls:FormField>
                            </Grid>
                            <controls:FormField Header="Turno (opcional)">
                                <ComboBox ItemsSource="{Binding ConfiguracionGrupo.TurnosSugeridos}"
                                          Text="{Binding ConfiguracionGrupo.Turno, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" IsTextSearchEnabled="True" MinHeight="40"
                                          AutomationProperties.Name="Turno opcional"/>
                            </controls:FormField>
                        </StackPanel>

                        <!-- Paso 4: Ubicación -->
                        <StackPanel Visibility="{Binding MostrarPasoUbicacion, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="4. Ubicación" Style="{StaticResource Heading2}"/>
                            <TextBlock Text="La ubicación es opcional. Si eliges una entidad, el municipio se limita al catálogo correspondiente."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <controls:FormField Grid.Column="0" Header="Entidad federativa (opcional)">
                                    <ComboBox ItemsSource="{Binding ConfiguracionGrupo.EntidadesFederativas}"
                                              SelectedItem="{Binding ConfiguracionGrupo.EntidadFederativa, Mode=TwoWay}"
                                              MinHeight="40"
                                              AutomationProperties.Name="Entidad federativa opcional"/>
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Header="Municipio (opcional)">
                                    <ComboBox ItemsSource="{Binding ConfiguracionGrupo.MunicipiosDisponibles}"
                                              SelectedItem="{Binding ConfiguracionGrupo.Municipio, Mode=TwoWay}"
                                              MinHeight="40"
                                              AutomationProperties.Name="Municipio opcional"/>
                                </controls:FormField>
                            </Grid>
                            <controls:FormField Header="Localidad (opcional)">
                                <TextBox Text="{Binding ConfiguracionGrupo.Localidad, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120" MinHeight="40"
                                         AutomationProperties.Name="Localidad opcional"/>
                            </controls:FormField>
                        </StackPanel>

                        <!-- Paso 5: Confirmar -->
                        <StackPanel Visibility="{Binding MostrarPasoConfirmar, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="5. Confirma el grupo" Style="{StaticResource Heading2}"/>
                            <TextBlock Text="Revisa lo que capturaste. Los datos que dejaste vacíos podrán completarse después desde Resumen → Configurar grupo."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,18"/>
                            <Border Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="10" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Grupo" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Grupo.NombreNuevoGrupo}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="Grados" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfiguracionGrupo.GradosTexto}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Text="Escuela" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfiguracionGrupo.NombreEscuela}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Text="CCT" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfiguracionGrupo.Cct}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Text="Ciclo / turno" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfiguracionGrupo.CicloEscolar}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Text="Turno" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ConfiguracionGrupo.Turno}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="6" Text="Entidad / municipio" FontWeight="SemiBold" Margin="0,0,10,8"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ConfiguracionGrupo.EntidadFederativa}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="7" Text="Municipio / localidad" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Row="7" Grid.Column="1">
                                        <TextBlock Text="{Binding ConfiguracionGrupo.Municipio}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ConfiguracionGrupo.Localidad}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding MensajeCreacionGrupo}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,16,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <Border Height="1" Background="{DynamicResource BorderLightBrush}" Margin="0,26,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Omitir por ahora"
                                    Command="{Binding OmitirPasoCreacionGrupoCommand}"
                                    Visibility="{Binding PuedeOmitirPasoCreacionGrupo, Converter={StaticResource BoolToVisibility}}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Omitir este paso opcional"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar"
                                        Command="{Binding CancelarCreacionGrupoCommand}"
                                        Margin="0,0,10,0"
                                        AutomationProperties.Name="Cancelar creación de grupo"/>
                                <Button Content="Siguiente"
                                        Command="{Binding SiguienteCreacionGrupoCommand}"
                                        Margin="0"
                                        AutomationProperties.Name="Ir al siguiente paso">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MostrarPasoConfirmar}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Crear grupo"
                                        Command="{Binding ConfirmarCreacionGrupoCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Visibility="{Binding MostrarPasoConfirmar, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0"
                                        AutomationProperties.Name="Crear grupo con la configuración mostrada"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
