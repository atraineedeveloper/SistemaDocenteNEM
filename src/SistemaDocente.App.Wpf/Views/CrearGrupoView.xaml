<UserControl x:Class="SistemaDocente.App.Wpf.Views.CrearGrupoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000"
             xml:lang="es-MX">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="760" Margin="40,34,40,48" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="←  Volver"
                        Command="{Binding CancelarCreacionGrupoCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="0"
                        Padding="10,7"
                        Margin="0,0,0,18"
                        AutomationProperties.Name="Volver sin crear el grupo"/>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="34">
                    <StackPanel>
                        <Border Width="52" Height="52"
                                HorizontalAlignment="Left"
                                CornerRadius="12"
                                Background="{DynamicResource HoverBackgroundBrush}"
                                Margin="0,0,0,18">
                            <TextBlock Text="👥" FontSize="23"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Crear nuevo grupo"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Configura la información básica del grupo. Podrás completar los demás datos después."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Margin="0,7,0,26"/>

                        <TextBlock Text="Nombre del grupo"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Grupo.NombreNuevoGrupo, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="42"
                                 Margin="0"
                                 MaxLength="120"
                                 AutomationProperties.Name="Nombre del grupo"/>
                        <TextBlock Text="Ejemplo: 5.º B o 3.º y 4.º multigrado"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,7,0,0"/>

                        <TextBlock Text="{Binding Grupo.MensajeEdicion}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <Border Height="1" Background="{DynamicResource BorderLightBrush}" Margin="0,28,0,18"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar"
                                    Command="{Binding CancelarCreacionGrupoCommand}"
                                    Margin="0,0,10,0"
                                    AutomationProperties.Name="Cancelar creación de grupo"/>
                            <Button Content="Crear grupo"
                                    Command="{Binding ConfirmarCreacionGrupoCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0"
                                    AutomationProperties.Name="Crear grupo"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
