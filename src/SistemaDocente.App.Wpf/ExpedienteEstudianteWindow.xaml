<Window x:Class="SistemaDocente.App.Wpf.ExpedienteEstudianteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expediente y Seguimiento Individual del Alumno" Height="680" Width="840" MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="90"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
    </Window.Resources>
    <Grid Background="#F8FAFC" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera del Alumno -->
        <DockPanel Margin="0,0,0,14" DataContext="{Binding Expediente}">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Ficha Individual del Estudiante" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding NumeroLista, StringFormat=#{0}}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding NombreEstudiante}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Right" CornerRadius="12" Padding="12,6" VerticalAlignment="Center" Background="#E2E8F0">
                <TextBlock Text="{Binding Asistencia.PorcentajeAsistencia, StringFormat=Asistencia: {0:F1}%}" FontWeight="Bold" Foreground="#1E293B"/>
            </Border>
        </DockPanel>

        <!-- Contenido por Pestañas -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#CBD5E1" Margin="0,0,0,10">
            <!-- Pestaña 1: Resumen y Alertas Pedagógicas -->
            <TabItem Header="Resumen Pedagógico">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel DataContext="{Binding Expediente}">
                        <TextBlock Text="Alertas Pedagógicas Formativas" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding AlertasPedagogicas}" Margin="0,0,0,16" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,3">
                                        <TextBlock Text="{Binding Mensaje}" Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Historial de Entregas por Proyectos" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,8"/>
                        <DataGrid ItemsSource="{Binding Entregas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="210">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proyecto" Binding="{Binding NombreProyecto}" Width="*"/>
                                <DataGridTextColumn Header="Actividad" Binding="{Binding TituloActividad}" Width="*"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Nivel de logro" Binding="{Binding NivelLogro}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Pestaña 2: Fortalezas y Dificultades -->
            <TabItem Header="Fortalezas y Dificultades">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fortalezas" FontSize="16" FontWeight="Bold" Foreground="#065F46" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Agregar" Command="{Binding AgregarFortalezaCommand}"/>
                            <TextBox Text="{Binding NuevaFortaleza, UpdateSourceTrigger=PropertyChanged}" ToolTip="Escriba una fortaleza pedagógica..."/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Expediente.Fortalezas}" Height="300" DisplayMemberPath="Contenido"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dificultades" FontSize="16" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Agregar" Command="{Binding AgregarDificultadCommand}"/>
                            <TextBox Text="{Binding NuevaDificultad, UpdateSourceTrigger=PropertyChanged}" ToolTip="Escriba una dificultad pedagógica..."/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Expediente.Dificultades}" Height="300" DisplayMemberPath="Contenido"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Pestaña 3: Apoyos y Observaciones -->
            <TabItem Header="Apoyos y Observaciones">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Apoyos Aplicados" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Agregar" Command="{Binding AgregarApoyoCommand}"/>
                            <TextBox Text="{Binding NuevoApoyo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Escriba un apoyo pedagógico aplicado..."/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Expediente.ApoyosAplicados}" Height="300" DisplayMemberPath="Contenido"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Observaciones Cronológicas" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Agregar" Command="{Binding AgregarObservacionCommand}"/>
                            <TextBox Text="{Binding NuevaObservacion, UpdateSourceTrigger=PropertyChanged}" ToolTip="Escriba una observación cronológica..."/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Expediente.ObservacionesCronologicas}" Height="300">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding FechaHoraRegistro, StringFormat=dd/MM/yyyy HH:mm}" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Contenido}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Pestaña 4: Acuerdos con Tutores -->
            <TabItem Header="Acuerdos con Tutores">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Registrar Acuerdo o Compromiso Familiar" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <TextBlock Text="Motivo de la reunión" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding MotivoAcuerdo, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Acuerdo o compromiso convenido" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding AcuerdoConvenido, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>

                        <TextBlock Text="Fecha de seguimiento opcional" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FechaSeguimientoAcuerdo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                        <WrapPanel Margin="0,4,0,12" HorizontalAlignment="Right">
                            <Button Content="+ Registrar Acuerdo" Command="{Binding AgregarAcuerdoCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="Histórico de Acuerdos Registrados" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,8"/>
                        <ListBox ItemsSource="{Binding Expediente.AcuerdosTutores}" Height="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8" Margin="0,4">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Motivo}" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FechaReunion, StringFormat=Fecha: {0:dd/MM/yyyy}}" Foreground="#64748B" FontSize="12"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding AcuerdoConvenido}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Cerrar" Click="OnCerrarClic" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
