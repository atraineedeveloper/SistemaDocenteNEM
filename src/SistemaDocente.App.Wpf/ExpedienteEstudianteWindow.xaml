<Window x:Class="SistemaDocente.App.Wpf.ExpedienteEstudianteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:prop="clr-namespace:SistemaDocente.App.Wpf.Properties"
        xml:lang="es-MX"
        Title="{x:Static prop:Resources.ExpedienteTitle}"
        Height="760" Width="980" MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PopupHeader}" DataContext="{Binding Expediente}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="EXPEDIENTE PEDAGÓGICO" Style="{StaticResource PopupEyebrow}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,5">
                        <TextBlock Text="{Binding NumeroLista, StringFormat=#{0}}" Style="{StaticResource PopupTitle}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding NombreEstudiante}" Style="{StaticResource PopupTitle}"/>
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Genero, StringFormat=Género: {0}}" Style="{StaticResource PopupSubtitle}" Margin="0,0,18,4"/>
                        <TextBlock Text="{Binding Edad, StringFormat=Edad: {0} años}" Style="{StaticResource PopupSubtitle}" Margin="0,0,18,4"/>
                        <TextBlock Text="{Binding FechaNacimiento, StringFormat=Nacimiento: {0:dd/MM/yyyy}}" Style="{StaticResource PopupSubtitle}" Margin="0,0,18,4"/>
                        <TextBlock Text="{Binding FechaIngreso, StringFormat=Ingreso: {0:dd/MM/yyyy}}" Style="{StaticResource PopupSubtitle}" Margin="0,0,18,4"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ObservacionesAlumno, StringFormat=Observaciones del registro: {0}}"
                               Style="{StaticResource PopupSubtitle}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource PopupInfoPill}" VerticalAlignment="Center" Margin="22,0,0,0">
                    <StackPanel MinWidth="96">
                        <TextBlock Text="Asistencia" Foreground="{DynamicResource InfoBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Asistencia.PorcentajeAsistencia, StringFormat={}{0:F1}%}"
                                   Foreground="{DynamicResource InfoBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,16">
            <TabControl Style="{StaticResource PopupTabControl}"
                        ItemContainerStyle="{StaticResource PopupTabItem}"
                        Background="Transparent">

                <TabItem Header="Resumen">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PopupCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Alertas pedagógicas formativas" Style="{StaticResource PopupSectionTitle}"/>
                                    <TextBlock Text="Señales para orientar el seguimiento docente; no representan diagnósticos clínicos."
                                               Style="{StaticResource PopupSubtitle}" Margin="0,0,0,10"/>
                                    <Grid MinHeight="72">
                                        <ListBox ItemsSource="{Binding Expediente.AlertasPedagogicas}"
                                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WarningBackgroundBrush}"
                                                            BorderBrush="{DynamicResource WarningBorderBrush}"
                                                            BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚠" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Mensaje}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <controls:EmptyState Icon="✓" Title="Sin alertas pedagógicas"
                                                             Message="No se han registrado alertas formativas para este estudiante."
                                                             Visibility="{Binding Expediente.AlertasPedagogicas.Count, Converter={StaticResource CountToVisibility}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource PopupCard}">
                                    <StackPanel>
                                        <TextBlock Text="Fortalezas" Style="{StaticResource PopupSectionTitle}" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="Capacidades, avances o recursos que conviene seguir potenciando."
                                                   Style="{StaticResource PopupSubtitle}" Margin="0,0,0,12"/>
                                        <controls:FormField Header="Nueva fortaleza">
                                            <TextBox Text="{Binding NuevaFortaleza, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="38" AutomationProperties.Name="Nueva fortaleza pedagógica"/>
                                        </controls:FormField>
                                        <Button Content="Agregar fortaleza" Command="{Binding AgregarFortalezaCommand}"
                                                HorizontalAlignment="Right" Margin="0,0,0,10"/>
                                        <Grid Height="220">
                                            <ListBox ItemsSource="{Binding Expediente.Fortalezas}" DisplayMemberPath="Contenido"
                                                     BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                     Background="{DynamicResource CardBackgroundBrush}"/>
                                            <controls:EmptyState Icon="＋" Title="Sin fortalezas registradas"
                                                                 Message="Registra fortalezas pedagógicas observadas."
                                                                 Visibility="{Binding Expediente.Fortalezas.Count, Converter={StaticResource CountToVisibility}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PopupCard}">
                                    <StackPanel>
                                        <TextBlock Text="Áreas de seguimiento" Style="{StaticResource PopupSectionTitle}" Foreground="{DynamicResource ErrorBrush}"/>
                                        <TextBlock Text="Dificultades observables que requieren acompañamiento pedagógico."
                                                   Style="{StaticResource PopupSubtitle}" Margin="0,0,0,12"/>
                                        <controls:FormField Header="Nueva dificultad">
                                            <TextBox Text="{Binding NuevaDificultad, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="38" AutomationProperties.Name="Nueva dificultad pedagógica"/>
                                        </controls:FormField>
                                        <Button Content="Agregar dificultad" Command="{Binding AgregarDificultadCommand}"
                                                HorizontalAlignment="Right" Margin="0,0,0,10"/>
                                        <Grid Height="220">
                                            <ListBox ItemsSource="{Binding Expediente.Dificultades}" DisplayMemberPath="Contenido"
                                                     BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                     Background="{DynamicResource CardBackgroundBrush}"/>
                                            <controls:EmptyState Icon="＋" Title="Sin dificultades registradas"
                                                                 Message="Registra áreas de seguimiento cuando sea necesario."
                                                                 Visibility="{Binding Expediente.Dificultades.Count, Converter={StaticResource CountToVisibility}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Seguimiento">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PopupCard}">
                                <StackPanel>
                                    <TextBlock Text="Apoyos aplicados" Style="{StaticResource PopupSectionTitle}" Foreground="{DynamicResource InfoBrush}"/>
                                    <TextBlock Text="Estrategias o apoyos que ya se han puesto en práctica con el estudiante."
                                               Style="{StaticResource PopupSubtitle}" Margin="0,0,0,12"/>
                                    <controls:FormField Header="Nuevo apoyo aplicado">
                                        <TextBox Text="{Binding NuevoApoyo, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38" AutomationProperties.Name="Nuevo apoyo pedagógico aplicado"/>
                                    </controls:FormField>
                                    <Button Content="Agregar apoyo" Command="{Binding AgregarApoyoCommand}"
                                            HorizontalAlignment="Right" Margin="0,0,0,10"/>
                                    <Grid Height="360">
                                        <ListBox ItemsSource="{Binding Expediente.ApoyosAplicados}" DisplayMemberPath="Contenido"
                                                 BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                 Background="{DynamicResource CardBackgroundBrush}"/>
                                        <controls:EmptyState Icon="＋" Title="Sin apoyos aplicados"
                                                             Message="Registra los apoyos pedagógicos brindados al estudiante."
                                                             Visibility="{Binding Expediente.ApoyosAplicados.Count, Converter={StaticResource CountToVisibility}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PopupCard}">
                                <StackPanel>
                                    <TextBlock Text="Historial de seguimiento" Style="{StaticResource PopupSectionTitle}"/>
                                    <TextBlock Text="Observaciones breves ordenadas cronológicamente para conservar evidencia del proceso."
                                               Style="{StaticResource PopupSubtitle}" Margin="0,0,0,12"/>
                                    <controls:FormField Header="Nueva observación">
                                        <TextBox Text="{Binding NuevaObservacion, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap"
                                                 AutomationProperties.Name="Nueva observación cronológica"/>
                                    </controls:FormField>
                                    <Button Content="Agregar al seguimiento" Command="{Binding AgregarObservacionCommand}"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
                                    <Grid Height="330">
                                        <ListBox ItemsSource="{Binding Expediente.ObservacionesCronologicas}"
                                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                                            <Border Width="2" Background="{DynamicResource BorderLightBrush}" Margin="0,18,0,-12" HorizontalAlignment="Center"/>
                                                        </Grid>
                                                        <Border Grid.Column="1" Background="{DynamicResource SectionBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                                CornerRadius="8" Padding="12,9">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FechaHoraRegistro, StringFormat=dd/MM/yyyy · HH:mm}"
                                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Contenido}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <controls:EmptyState Icon="📝" Title="Sin observaciones"
                                                             Message="Agrega una observación para iniciar el historial de seguimiento."
                                                             Visibility="{Binding Expediente.ObservacionesCronologicas.Count, Converter={StaticResource CountToVisibility}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Actividades">
                    <Grid Margin="0,16,0,0">
                        <Border Style="{StaticResource PopupCard}">
                            <StackPanel>
                                <TextBlock Text="Historial de actividades y evaluación" Style="{StaticResource PopupSectionTitle}"/>
                                <TextBlock Text="Consulta proyecto, actividad, fecha y nivel de logro registrado para este estudiante."
                                           Style="{StaticResource PopupSubtitle}" Margin="0,0,0,12"/>
                                <Grid Height="430">
                                    <DataGrid ItemsSource="{Binding Expediente.Entregas}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              CanUserSortColumns="True" EnableRowVirtualization="True"
                                              RowHeight="42" BorderBrush="{DynamicResource BorderLightBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Proyecto" Binding="{Binding NombreProyecto}" Width="*"/>
                                            <DataGridTextColumn Header="Actividad" Binding="{Binding TituloActividad}" Width="*"/>
                                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="110"/>
                                            <DataGridTextColumn Header="Nivel de logro" Binding="{Binding NivelLogro}" Width="140"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <controls:EmptyState Icon="📋" Title="Sin actividades evaluadas"
                                                         Message="Este estudiante aún no tiene registros de evaluación por actividades."
                                                         Visibility="{Binding Expediente.Entregas.Count, Converter={StaticResource CountToVisibility}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Familia">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PopupCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Registrar acuerdo o compromiso familiar" Style="{StaticResource PopupSectionTitle}"/>
                                    <TextBlock Text="Documenta el motivo, el acuerdo y una fecha de seguimiento cuando corresponda."
                                               Style="{StaticResource PopupSubtitle}" Margin="0,0,0,14"/>
                                    <controls:FormField Header="Motivo de la reunión *">
                                        <TextBox Text="{Binding MotivoAcuerdo, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38" AutomationProperties.Name="Motivo de la reunión con tutores"/>
                                    </controls:FormField>
                                    <controls:FormField Header="Acuerdo o compromiso convenido *">
                                        <TextBox Text="{Binding AcuerdoConvenido, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="76" TextWrapping="Wrap"
                                                 AutomationProperties.Name="Acuerdo o compromiso convenido"/>
                                    </controls:FormField>
                                    <controls:FormField Header="Fecha de seguimiento opcional">
                                        <DatePicker SelectedDate="{Binding FechaSeguimientoAcuerdo, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource PopupDatePicker}"
                                                    AutomationProperties.Name="Fecha de seguimiento del acuerdo"/>
                                    </controls:FormField>
                                    <Button Content="Registrar acuerdo" Command="{Binding AgregarAcuerdoCommand}"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PopupCard}">
                                <StackPanel>
                                    <TextBlock Text="Historial de acuerdos" Style="{StaticResource PopupSectionTitle}"/>
                                    <TextBlock Text="Consulta los compromisos registrados con familiares o tutores."
                                               Style="{StaticResource PopupSubtitle}" Margin="0,0,0,10"/>
                                    <Grid Height="270">
                                        <ListBox ItemsSource="{Binding Expediente.AcuerdosTutores}"
                                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SectionBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="12" Margin="0,4">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Motivo}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FechaReunion, StringFormat={}{0:dd/MM/yyyy}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding AcuerdoConvenido}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <controls:EmptyState Icon="🤝" Title="Sin acuerdos registrados"
                                                             Message="Registra acuerdos o compromisos familiares cuando corresponda."
                                                             Visibility="{Binding Expediente.AcuerdosTutores.Count, Converter={StaticResource CountToVisibility}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PopupFooter}">
            <Grid>
                <TextBlock Text="Expediente = seguimiento editable · Reportes = síntesis generada"
                           Style="{StaticResource PopupSubtitle}" VerticalAlignment="Center"/>
                <Button Content="Cerrar" Click="OnCerrarClic" IsCancel="True"
                        HorizontalAlignment="Right" MinWidth="100"
                        AutomationProperties.Name="Cerrar expediente del estudiante"/>
            </Grid>
        </Border>
    </Grid>
</Window>