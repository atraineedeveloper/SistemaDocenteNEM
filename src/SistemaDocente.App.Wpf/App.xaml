<Application x:Class="SistemaDocente.App.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaDocente.App.Wpf"
             xmlns:converters="clr-namespace:SistemaDocente.App.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFontFamily">pack://application:,,,/SistemaDocente.App.Wpf;component/Fonts/#Montserrat, Segoe UI, sans-serif</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <!-- ESTILO FOCO VISUAL GLOBAL -->
        <Style x:Key="AppFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeDashArray="2 2" RadiusX="{DynamicResource CornerRadiusSmall}" RadiusY="{DynamicResource CornerRadiusSmall}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>

        <!-- ESTILO BASE BOTÓN FLUENT -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingButton}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginSmall}"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Padding="{TemplateBinding Padding}"
                                Opacity="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÓN PRIMARIO -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TextDisabledBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO TEXTBOX FLUENT -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingTextBox}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginFormField}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <!-- ESTILO COMBOBOX FLUENT -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="{DynamicResource MarginSmall}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <!-- ESTILO DATAGRID COLUMN HEADER FLUENT -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeFormLabel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingTextBox}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- ESTILO DATAGRID FLUENT -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SectionBackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource HoverBackgroundBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderLightBrush}"/>
        </Style>

        <!-- ESTILO BOTÓN PESTAÑA NAVEGACIÓN FLUENT — con indicador de activo -->
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingNavTab}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginSmallHorizontal}"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeFormLabel}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6,6,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <!-- Indicador inferior de pestaña activa -->
                            <Border x:Name="ActiveIndicator"
                                    Height="3" VerticalAlignment="Bottom"
                                    CornerRadius="2,2,0,0"
                                    Background="{DynamicResource PrimaryHoverBrush}"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                            </Trigger>
                            <!-- Tag="activo" = pestaña activa actual -->
                            <Trigger Property="Tag" Value="activo">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÓN CABECERA HEADER -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingHeaderButton}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginSmallHorizontal}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeFormLabel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════════════════════════════════════════
             SISTEMA TIPOGRÁFICO UNIFICADO
             ════════════════════════════════════════════════════ -->

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="Heading1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading1}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="Heading2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading2}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="Heading3" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading3}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeFormLabel}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginFormLabel}"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextCaptionBrush}"/>
        </Style>

        <!-- Subtítulo de sección (texto muted encima de un heading) -->
        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeFormLabel}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- ════════════════════════════════════════════════════
             CARD DE SECCIÓN — para formularios
             ════════════════════════════════════════════════════ -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingCard}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginCardBottom}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Card estándar (blanca, con borde suave) -->
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingContentCard}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginContentCardBottom}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Banner de advertencia -->
        <Style x:Key="AlertWarningBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingBanner}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginBanner}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Banner de error -->
        <Style x:Key="AlertErrorBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingBanner}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginBanner}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Banner de éxito -->
        <Style x:Key="AlertSuccessBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Padding" Value="{DynamicResource PaddingBanner}"/>
            <Setter Property="Margin" Value="{DynamicResource MarginBanner}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Validation.ErrorTemplate global: borde rojo + mensaje inline -->
        <ControlTemplate x:Key="AppValidationErrorTemplate">
            <Grid SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" Grid.Row="0">
                    <AdornedElementPlaceholder x:Name="AdornedElement"/>
                </Border>
                <TextBlock Grid.Row="1" Margin="0,4,0,0"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextWrapping="Wrap"
                           Text="{Binding ElementName=AdornedElement, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
            </Grid>
        </ControlTemplate>
        <Style TargetType="FrameworkElement">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource AppValidationErrorTemplate}"/>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
