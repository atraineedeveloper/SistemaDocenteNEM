<Window x:Class="SistemaDocente.App.Wpf.EditarEvaluacionCeldaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="es-MX"
        Title="Editar evaluación"
        Width="520" Height="410" MinWidth="480" MinHeight="380"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="ActividadText" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="EstudianteText" Style="{StaticResource Heading2}" FontSize="20" Margin="0,4,0,2"/>
            <TextBlock Text="La edición se conserva localmente hasta que guardes los cambios del proyecto." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Nivel de logro" Style="{StaticResource FormLabel}"/>
            <ComboBox ItemsSource="{Binding OpcionesNivel}"
                      DisplayMemberPath="Texto"
                      SelectedValuePath="Nivel"
                      SelectedValue="{Binding NivelLogro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="Nivel de logro"
                      TabIndex="1"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Observación" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     MaxLength="500" MinHeight="150" VerticalContentAlignment="Top"
                     AutomationProperties.Name="Observación de la evaluación" TabIndex="2"/>
            <TextBlock Text="Máximo 500 caracteres. Registra observaciones breves y pedagógicas." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Click="OnCancelar" TabIndex="3"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Aceptar" IsDefault="True" Click="OnAceptar" TabIndex="4"/>
        </StackPanel>
    </Grid>
</Window>