<Window x:Class="SistemaDocente.App.Wpf.EditarEvaluacionCeldaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xml:lang="es-MX"
        Title="Editar evaluación"
        Width="580" Height="590" MinWidth="520" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PopupHeader}">
            <StackPanel>
                <TextBlock x:Name="ActividadText" Style="{StaticResource PopupEyebrow}"/>
                <TextBlock x:Name="EstudianteText" Style="{StaticResource PopupTitle}" Margin="0,4,0,4"/>
                <TextBlock Text="Registra por separado la entrega, el nivel de logro y una observación pedagógica breve."
                           Style="{StaticResource PopupSubtitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
            <Border Style="{StaticResource PopupCard}">
                <StackPanel>
                    <TextBlock Text="Evaluación de la actividad" Style="{StaticResource PopupSectionTitle}"/>
                    <TextBlock Text="Los cambios se aplican primero a la matriz y se persisten cuando guardas Evaluación."
                               Style="{StaticResource PopupSubtitle}" Margin="0,0,0,14"/>

                    <controls:FormField Header="Estado de entrega *">
                        <ComboBox ItemsSource="{Binding OpcionesEstadoEntrega}"
                                  DisplayMemberPath="Texto"
                                  SelectedValuePath="Estado"
                                  SelectedValue="{Binding EstadoEntrega, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MinHeight="38"
                                  Margin="0,4,0,10"
                                  AutomationProperties.Name="Estado de entrega"
                                  TabIndex="1"/>
                    </controls:FormField>
                    <TextBlock Text="Una entrega puede registrarse primero y evaluarse después."
                               Style="{StaticResource PopupSubtitle}" Margin="0,-6,0,12"/>

                    <controls:FormField Header="Nivel de logro">
                        <ComboBox ItemsSource="{Binding OpcionesNivel}"
                                  DisplayMemberPath="Texto"
                                  SelectedValuePath="Nivel"
                                  SelectedValue="{Binding NivelLogro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding PuedeEvaluarLogro}"
                                  MinHeight="38"
                                  Margin="0,4,0,10"
                                  AutomationProperties.Name="Nivel de logro"
                                  TabIndex="2"/>
                    </controls:FormField>
                    <TextBlock Text="El nivel sólo se habilita cuando la actividad está marcada como entregada."
                               Style="{StaticResource PopupSubtitle}" Margin="0,-6,0,12"/>

                    <controls:FormField Header="Observación pedagógica">
                        <TextBox Text="{Binding Observacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="500"
                                 MinHeight="150"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Observación de la evaluación"
                                 TabIndex="3"/>
                    </controls:FormField>

                    <TextBlock Text="Máximo 500 caracteres. Describe evidencia observable o retroalimentación útil."
                               Style="{StaticResource PopupSubtitle}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PopupFooter}">
            <Grid>
                <TextBlock Text="Esc para cancelar"
                           Style="{StaticResource PopupSubtitle}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            IsCancel="True"
                            Click="OnCancelar"
                            MinWidth="100"
                            TabIndex="4"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Aplicar a la matriz"
                            IsDefault="True"
                            Click="OnAceptar"
                            MinWidth="150"
                            TabIndex="5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
