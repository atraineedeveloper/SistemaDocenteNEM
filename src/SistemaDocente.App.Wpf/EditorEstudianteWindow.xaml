<Window x:Class="SistemaDocente.App.Wpf.EditorEstudianteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xml:lang="es-MX"
        Title="{Binding TituloEditorEstudiante}" Height="600" Width="640" MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{DynamicResource SectionBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="20,16" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Gestión de Alumnos" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding TituloEditorEstudiante}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenido Principal con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,16,10">
            <StackPanel>
                <!-- Sección 1: Datos Personales -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="📌 Datos Personales" Style="{StaticResource Heading3}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <!-- Apellidos (2 Columnas) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <controls:FormField Grid.Column="0" Header="Primer apellido *">
                                <TextBox TabIndex="10" Text="{Binding PrimerApellidoEdicion, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </controls:FormField>

                            <controls:FormField Grid.Column="2" Header="Segundo apellido">
                                <TextBox TabIndex="11" Text="{Binding SegundoApellidoEdicion, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </controls:FormField>
                        </Grid>

                        <!-- Nombres (Fila completa) -->
                        <controls:FormField Header="Nombre(s) *">
                            <TextBox TabIndex="12" Text="{Binding NombresEdicion, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </controls:FormField>
                    </StackPanel>
                </Border>

                <!-- Sección 2: Datos Escolares -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="🎓 Datos Escolares" Style="{StaticResource Heading3}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <controls:FormField Grid.Column="0" Header="Núm. lista *">
                                <TextBox TabIndex="13" Text="{Binding NumeroListaEdicion, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding GuardarEstudianteCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </controls:FormField>

                            <controls:FormField Grid.Column="2" Header="Género *">
                                <ComboBox TabIndex="14" SelectedIndex="{Binding GeneroIndexEdicion, Mode=TwoWay}" AutomationProperties.Name="Género del estudiante">
                                    <ComboBoxItem Content="No especificado"/>
                                    <ComboBoxItem Content="Hombre"/>
                                    <ComboBoxItem Content="Mujer"/>
                                </ComboBox>
                            </controls:FormField>

                            <controls:FormField Grid.Column="4" Header="Fecha de nacimiento *">
                                <DatePicker TabIndex="15" SelectedDate="{Binding FechaNacimientoEdicion, Mode=TwoWay}" AutomationProperties.Name="Fecha de nacimiento del estudiante"/>
                            </controls:FormField>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sección 3: Observaciones -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="📝 Observaciones Particulares" Style="{StaticResource Heading3}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>

                        <controls:FormField Header="Registro cualitativo">
                            <TextBox TabIndex="16" Text="{Binding ObservacionesEdicion, UpdateSourceTrigger=PropertyChanged}"
                                     Height="65" TextWrapping="Wrap" AcceptsReturn="True"
                                     ToolTip="Registro cualitativo y pedagógico del estudiante"/>
                        </controls:FormField>
                    </StackPanel>
                </Border>

                <!-- Mensaje de error/validación -->
                <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding MensajeEdicion}" Margin="4,4,4,6" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botonera Inferior -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="16,12" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button TabIndex="20" Content="Cancelar" Click="OnCancelarClic" IsCancel="True" Margin="0,0,10,0" MinWidth="90"/>
                    <Button Style="{StaticResource PrimaryButton}" TabIndex="19" Content="💾 Guardar estudiante" Click="OnGuardarClic" IsDefault="True" MinWidth="140"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
