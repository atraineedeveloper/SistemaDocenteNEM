<Window x:Class="SistemaDocente.App.Wpf.EditorEstudianteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xml:lang="es-MX"
        Title="{Binding TituloEditorEstudiante}"
        Height="700" Width="780" MinHeight="580" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarEstudianteCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PopupHeader}">
            <StackPanel>
                <TextBlock Text="ESTUDIANTE" Style="{StaticResource PopupEyebrow}"/>
                <TextBlock Text="{Binding TituloEditorEstudiante}" Style="{StaticResource PopupTitle}" Margin="0,4,0,4"/>
                <TextBlock Text="Completa los datos básicos y el grado escolar del estudiante. Los campos marcados con * son obligatorios."
                           Style="{StaticResource PopupSubtitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
            <StackPanel>
                <Border Style="{StaticResource PopupCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Datos personales" Style="{StaticResource PopupSectionTitle}"/>
                        <TextBlock Text="Nombre legal o de uso escolar con el que se identificará al estudiante."
                                   Style="{StaticResource PopupSubtitle}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <controls:FormField Grid.Column="0" Header="Primer apellido *">
                                <TextBox TabIndex="10"
                                         MinHeight="38"
                                         Text="{Binding PrimerApellidoEdicion, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Primer apellido del estudiante"/>
                            </controls:FormField>

                            <controls:FormField Grid.Column="2" Header="Segundo apellido">
                                <TextBox TabIndex="11"
                                         MinHeight="38"
                                         Text="{Binding SegundoApellidoEdicion, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Segundo apellido del estudiante"/>
                            </controls:FormField>
                        </Grid>

                        <controls:FormField Header="Nombre(s) *">
                            <TextBox TabIndex="12"
                                     MinHeight="38"
                                     Text="{Binding NombresEdicion, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Nombres del estudiante"/>
                        </controls:FormField>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PopupCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Datos escolares" Style="{StaticResource PopupSectionTitle}"/>
                        <TextBlock Text="El grado se limita a los grados configurados para el grupo. En un grupo unigrado se preselecciona automáticamente."
                                   Style="{StaticResource PopupSubtitle}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <controls:FormField Grid.Column="0" Header="Núm. de lista *">
                                <TextBox TabIndex="13"
                                         MinHeight="38"
                                         Text="{Binding NumeroListaEdicion, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Número de lista del estudiante"/>
                            </controls:FormField>

                            <controls:FormField Grid.Column="2" Header="Grado *">
                                <ComboBox TabIndex="14"
                                          MinHeight="38"
                                          Margin="0,4,0,10"
                                          ItemsSource="{Binding GradosDisponiblesEdicion}"
                                          DisplayMemberPath="Texto"
                                          SelectedValuePath="Valor"
                                          SelectedValue="{Binding GradoEdicion, Mode=TwoWay}"
                                          AutomationProperties.Name="Grado de primaria del estudiante"/>
                            </controls:FormField>

                            <controls:FormField Grid.Column="4" Header="Género *">
                                <ComboBox TabIndex="15"
                                          MinHeight="38"
                                          Margin="0,4,0,10"
                                          SelectedIndex="{Binding GeneroIndexEdicion, Mode=TwoWay}"
                                          AutomationProperties.Name="Género del estudiante">
                                    <ComboBoxItem Content="No especificado"/>
                                    <ComboBoxItem Content="Hombre"/>
                                    <ComboBoxItem Content="Mujer"/>
                                </ComboBox>
                            </controls:FormField>

                            <controls:FormField Grid.Column="6" Header="Fecha de nacimiento *">
                                <DatePicker TabIndex="16"
                                            Style="{StaticResource PopupDatePicker}"
                                            SelectedDate="{Binding FechaNacimientoEdicion, Mode=TwoWay}"
                                            AutomationProperties.Name="Fecha de nacimiento del estudiante"/>
                            </controls:FormField>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PopupCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Observaciones particulares" Style="{StaticResource PopupSectionTitle}"/>
                        <TextBlock Text="Registra únicamente información pedagógica útil para el seguimiento."
                                   Style="{StaticResource PopupSubtitle}" Margin="0,0,0,14"/>

                        <controls:FormField Header="Registro cualitativo">
                            <TextBox TabIndex="17"
                                     Text="{Binding ObservacionesEdicion, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="110"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Observaciones particulares del estudiante"/>
                        </controls:FormField>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding MensajeEdicion}"
                           Foreground="{DynamicResource ErrorBrush}"
                           Margin="4,0,4,4"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PopupFooter}">
            <Grid>
                <TextBlock Text="Ctrl+S para guardar · Esc para cancelar"
                           Style="{StaticResource PopupSubtitle}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button TabIndex="20"
                            Content="Cancelar"
                            Click="OnCancelarClic"
                            IsCancel="True"
                            MinWidth="100"/>
                    <Button TabIndex="19"
                            Style="{StaticResource PrimaryButton}"
                            Content="Guardar estudiante"
                            Click="OnGuardarClic"
                            IsDefault="True"
                            MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
