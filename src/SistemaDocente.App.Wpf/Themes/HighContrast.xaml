<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PALETA DE ALTO CONTRASTE -->

    <!-- Primarios -->
    <Color x:Key="PrimaryColor">#FFFF00</Color>
    <Color x:Key="PrimaryHoverColor">#FFFF00</Color>
    <Color x:Key="PrimaryPressedColor">#FFFF00</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>

    <!-- Fondos -->
    <Color x:Key="WindowBackgroundColor">#000000</Color>
    <Color x:Key="CardBackgroundColor">#000000</Color>
    <Color x:Key="SectionBackgroundColor">#000000</Color>
    <Color x:Key="HoverBackgroundColor">#1A1A1A</Color>
    <Color x:Key="PressedBackgroundColor">#333333</Color>
    <Color x:Key="DisabledBackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="{StaticResource SectionBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}"/>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#FFFFFF</Color>
    <Color x:Key="TextCaptionColor">#FFFFFF</Color>
    <Color x:Key="TextDisabledColor">#808080</Color>
    <Color x:Key="TextOnPrimaryColor">#000000</Color>
    <Color x:Key="TextOnDarkColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextCaptionBrush" Color="{StaticResource TextCaptionColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}"/>

    <!-- Bordes -->
    <Color x:Key="BorderDefaultColor">#FFFFFF</Color>
    <Color x:Key="BorderLightColor">#FFFFFF</Color>
    <Color x:Key="BorderHoverColor">#FFFF00</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>

    <!-- Estados semánticos -->
    <Color x:Key="SuccessColor">#00FF00</Color>
    <Color x:Key="SuccessBackgroundColor">#000000</Color>
    <Color x:Key="SuccessBorderColor">#00FF00</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}"/>

    <Color x:Key="InfoColor">#00FFFF</Color>
    <Color x:Key="InfoBackgroundColor">#000000</Color>
    <Color x:Key="InfoBorderColor">#00FFFF</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoBackgroundColor}"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}"/>

    <Color x:Key="WarningColor">#FFFF00</Color>
    <Color x:Key="WarningBackgroundColor">#000000</Color>
    <Color x:Key="WarningBorderColor">#FFFF00</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackgroundColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}"/>

    <Color x:Key="ErrorColor">#FF0000</Color>
    <Color x:Key="ErrorBackgroundColor">#000000</Color>
    <Color x:Key="ErrorBorderColor">#FF0000</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackgroundColor}"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}"/>

</ResourceDictionary>
