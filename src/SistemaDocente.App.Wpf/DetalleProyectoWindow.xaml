<Window x:Class="SistemaDocente.App.Wpf.DetalleProyectoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:prop="clr-namespace:SistemaDocente.App.Wpf.Properties"
        xml:lang="es-MX"
        Title="{x:Static prop:Resources.DetalleProyectoTitle}" Height="620" Width="720" MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{DynamicResource SectionBackgroundBrush}" Margin="{DynamicResource MarginXXXLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel><TextBlock Text="Proyectos -> Detalle" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource Caption}" Margin="0,0,0,6" AutomationProperties.Name="Ruta de navegacion: Proyectos a Detalle"/><DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Proyecto Didáctico" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding NombreProyecto}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" CornerRadius="16" Padding="12,5" VerticalAlignment="Center" Background="#EFF8FF" BorderBrush="#B2DDFF" BorderThickness="1">
                <TextBlock Text="{Binding ProyectoSeleccionado.Estado}" FontWeight="SemiBold" Foreground="#175CD3"/>
            </Border>
        </DockPanel></StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Información del Proyecto" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <controls:FormField Header="{x:Static prop:Resources.NombreProyecto}">
                            <TextBox Text="{Binding NombreProyecto, UpdateSourceTrigger=PropertyChanged}" TabIndex="10" AutomationProperties.Name="Nombre del proyecto"/>
                        </controls:FormField>

                        <controls:FormField Header="{x:Static prop:Resources.Descripcion}">
                            <TextBox Text="{Binding DescripcionProyecto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" TextWrapping="Wrap" TabIndex="11" AutomationProperties.Name="Descripción del proyecto"/>
                        </controls:FormField>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:FormField Grid.Column="0" Header="{x:Static prop:Resources.FechaInicio}">
                                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}" TabIndex="12" AutomationProperties.Name="Fecha de inicio del proyecto"/>
                            </controls:FormField>
                            <controls:FormField Grid.Column="2" Header="{x:Static prop:Resources.FechaTermino}">
                                <DatePicker SelectedDate="{Binding FechaTermino, Mode=TwoWay}" TabIndex="13" AutomationProperties.Name="Fecha de término del proyecto"/>
                            </controls:FormField>
                        </Grid>

                        <Border Background="#FFFAEB" BorderBrush="#FEF0C7" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,12"
                                Visibility="{Binding DuracionAtipica, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ " Foreground="#B54708" FontSize="14"/>
                                <TextBlock Foreground="#B54708" FontWeight="Medium" TextWrapping="Wrap"
                                           Text="Duración fuera del rango estándar (14–31 días). Puedes guardar si es intencional."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Static prop:Resources.Observaciones}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ObservacionesProyecto, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="55" TextWrapping="Wrap" TabIndex="14" AutomationProperties.Name="Observaciones del proyecto"/>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="_Guardar cambios" Command="{Binding GuardarProyectoCommand}" TabIndex="20" IsDefault="True"/>
                            <Button Content="_Iniciar" Command="{Binding IniciarProyectoCommand}" TabIndex="21"/>
                            <Button Content="_Finalizar" Command="{Binding FinalizarProyectoCommand}" TabIndex="22"/>
                            <Button Content="_Reabrir" Command="{Binding ReabrirProyectoCommand}" TabIndex="23"/>
                            <Button Content="_Eliminar borrador" Command="{Binding EliminarProyectoCommand}" TabIndex="24"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Actividades del Proyecto" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Content="+ _Nueva Actividad" Click="OnNuevaActividadClic" TabIndex="30" AutomationProperties.Name="Crear nueva actividad"/>
                        </DockPanel>

                        <TextBox Text="{Binding BusquedaActividad, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar actividad..." Margin="0,0,0,10" TabIndex="31" AutomationProperties.Name="Buscar actividad"/>

                        <Grid Height="170">
                            <ListBox ItemsSource="{Binding Actividades}" SelectedItem="{Binding ActividadSeleccionada}" MouseDoubleClick="OnActividadDobleClic" TabIndex="32" AutomationProperties.Name="Lista de actividades del proyecto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4">
                                            <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Estado}" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding FechaRealizacion, StringFormat=Fecha: {0:dd/MM/yyyy}}" Foreground="#64748B" FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <controls:EmptyState Icon="📋" Title="Sin actividades" Message="Este proyecto aún no tiene actividades registradas." Visibility="{Binding Actividades.Count, Converter={StaticResource CountToVisibility}}"/>
                        </Grid>
                        
                        <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                            <Button Content="✏️ _Editar actividad seleccionada" Click="OnEditarActividadClic" TabIndex="33"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="_Cerrar" Click="OnCerrarClic" IsCancel="True" MinWidth="110" TabIndex="90" AutomationProperties.Name="Cerrar ventana de detalle"/>
        </StackPanel>
    </Grid>
</Window>
