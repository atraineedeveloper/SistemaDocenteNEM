<Window x:Class="SistemaDocente.App.Wpf.DetalleProyectoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SistemaDocente.App.Wpf.Controls"
        xmlns:prop="clr-namespace:SistemaDocente.App.Wpf.Properties"
        xml:lang="es-MX"
        Title="{x:Static prop:Resources.DetalleProyectoTitle}"
        Height="760" Width="860" MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding GuardarProyectoCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PopupHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PLANEACIÓN DIDÁCTICA · PROYECTO" Style="{StaticResource PopupEyebrow}"/>
                    <TextBlock Text="{Binding NombreProyecto}" Style="{StaticResource PopupTitle}" Margin="0,4,0,4"/>
                    <TextBlock Text="Edita la planeación y administra las actividades sin salir del contexto del proyecto."
                               Style="{StaticResource PopupSubtitle}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource PopupInfoPill}"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                    <TextBlock Text="{Binding ProyectoSeleccionado.Estado}"
                               Foreground="{DynamicResource InfoBrush}"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
            <StackPanel>
                <Border Style="{StaticResource PopupCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Datos del proyecto" Style="{StaticResource PopupSectionTitle}"/>
                        <TextBlock Text="Mantén una descripción breve, define la metodología NEM y delimita los grados a los que se dirige."
                                   Style="{StaticResource PopupSubtitle}" Margin="0,0,0,14"/>

                        <controls:FormField Header="{x:Static prop:Resources.NombreProyecto}">
                            <TextBox Text="{Binding NombreProyecto, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="38"
                                     TabIndex="10"
                                     AutomationProperties.Name="Nombre del proyecto"/>
                        </controls:FormField>

                        <controls:FormField Header="{x:Static prop:Resources.Descripcion}">
                            <TextBox Text="{Binding DescripcionProyecto, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="90"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     TabIndex="11"
                                     AutomationProperties.Name="Descripción del proyecto"/>
                        </controls:FormField>

                        <controls:FormField Header="Metodología NEM *">
                            <ComboBox ItemsSource="{Binding MetodologiasProyecto}"
                                      DisplayMemberPath="Texto"
                                      SelectedValuePath="Valor"
                                      SelectedValue="{Binding MetodologiaProyecto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="38"
                                      TabIndex="12"
                                      AutomationProperties.Name="Metodología NEM del proyecto"/>
                        </controls:FormField>

                        <controls:FormField Header="Grados objetivo *">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding GradosProyecto}"
                                              AutomationProperties.Name="Grados objetivo del proyecto">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Texto}"
                                                      IsChecked="{Binding Seleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,0,18,8"
                                                      MinWidth="52"
                                                      AutomationProperties.Name="{Binding Texto}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="En un grupo unigrado el grado se preselecciona; en multigrado puedes elegir uno o varios grados atendidos."
                                           Style="{StaticResource PopupSubtitle}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </controls:FormField>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <controls:FormField Grid.Column="0" Header="{x:Static prop:Resources.FechaInicio}">
                                <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}"
                                            Style="{StaticResource PopupDatePicker}"
                                            TabIndex="13"
                                            AutomationProperties.Name="Fecha de inicio del proyecto"/>
                            </controls:FormField>

                            <controls:FormField Grid.Column="2" Header="{x:Static prop:Resources.FechaTermino}">
                                <DatePicker SelectedDate="{Binding FechaTermino, Mode=TwoWay}"
                                            Style="{StaticResource PopupDatePicker}"
                                            TabIndex="14"
                                            AutomationProperties.Name="Fecha de término del proyecto"/>
                            </controls:FormField>
                        </Grid>

                        <Border Style="{StaticResource AlertWarningBanner}"
                                Visibility="{Binding DuracionAtipica, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0"/>
                                <TextBlock Foreground="{DynamicResource WarningBrush}"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap"
                                           Text="Duración fuera del rango orientativo de 14–31 días. Puedes guardar si es intencional."/>
                            </StackPanel>
                        </Border>

                        <controls:FormField Header="{x:Static prop:Resources.Observaciones}">
                            <TextBox Text="{Binding ObservacionesProyecto, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     TabIndex="15"
                                     AutomationProperties.Name="Observaciones del proyecto"/>
                        </controls:FormField>

                        <Border Background="{DynamicResource SectionBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Padding="14"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Estado del proyecto" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Estas acciones cambian el ciclo de vida del proyecto."
                                               Style="{StaticResource PopupSubtitle}" Margin="0,2,0,8"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1">
                                    <Button Content="Iniciar proyecto" Command="{Binding IniciarProyectoCommand}" TabIndex="20"/>
                                    <Button Content="Finalizar proyecto" Command="{Binding FinalizarProyectoCommand}" TabIndex="21"/>
                                    <Button Content="Reabrir proyecto" Command="{Binding ReabrirProyectoCommand}" TabIndex="22"/>
                                    <Button Style="{StaticResource PopupDestructiveButton}"
                                            Content="Eliminar borrador"
                                            Command="{Binding EliminarProyectoCommand}"
                                            TabIndex="23"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PopupCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Actividades del proyecto" Style="{StaticResource PopupSectionTitle}"/>
                                <TextBlock Text="Abre una actividad para editar su información y seguimiento."
                                           Style="{StaticResource PopupSubtitle}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Nueva actividad"
                                    Click="OnNuevaActividadClic"
                                    TabIndex="30"
                                    AutomationProperties.Name="Crear nueva actividad"/>
                        </Grid>

                        <controls:FormField Header="Buscar actividad">
                            <TextBox Text="{Binding BusquedaActividad, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="38"
                                     TabIndex="31"
                                     AutomationProperties.Name="Buscar actividad"/>
                        </controls:FormField>

                        <Grid MinHeight="190" Height="220">
                            <ListBox ItemsSource="{Binding Actividades}"
                                     SelectedItem="{Binding ActividadSeleccionada}"
                                     MouseDoubleClick="OnActividadDobleClic"
                                     BorderBrush="{DynamicResource BorderLightBrush}"
                                     BorderThickness="1"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     TabIndex="32"
                                     AutomationProperties.Name="Lista de actividades del proyecto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding FechaRealizacion, StringFormat=Fecha: {0:dd/MM/yyyy}}"
                                                           Style="{StaticResource PopupSubtitle}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource PopupNeutralPill}"
                                                    VerticalAlignment="Center"
                                                    Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Estado}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <controls:EmptyState Icon="📋"
                                                 Title="Sin actividades"
                                                 Message="Este proyecto aún no tiene actividades registradas."
                                                 Visibility="{Binding Actividades.Count, Converter={StaticResource CountToVisibility}}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Editar actividad seleccionada"
                                    Click="OnEditarActividadClic"
                                    TabIndex="33"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PopupFooter}">
            <Grid>
                <TextBlock Text="Ctrl+S para guardar · doble clic para abrir una actividad"
                           Style="{StaticResource PopupSubtitle}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cerrar"
                            Click="OnCerrarClic"
                            IsCancel="True"
                            MinWidth="100"
                            TabIndex="90"
                            AutomationProperties.Name="Cerrar ventana de detalle"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Guardar cambios"
                            Command="{Binding GuardarProyectoCommand}"
                            IsDefault="True"
                            MinWidth="140"
                            TabIndex="89"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>