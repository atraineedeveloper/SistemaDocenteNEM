<Window x:Class="SistemaDocente.App.Wpf.ConfiguracionGrupoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="es-MX"
        Title="Configuración del grupo"
        Width="820" Height="790" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{DynamicResource SectionBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,17">
            <StackPanel>
                <TextBlock Text="CONFIGURACIÓN DEL GRUPO"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="Contexto escolar, NEM y organización del grupo"
                           Style="{StaticResource Heading2}" Margin="0,3,0,3"/>
                <TextBlock Text="Selecciona datos estructurados cuando existe un catálogo. La fase NEM y la modalidad del grupo se calculan automáticamente a partir de los grados atendidos."
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,14,16,10">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Escuela" Style="{StaticResource Heading3}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Ciclo escolar" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding CicloEscolar, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Nombre de la escuela" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding NombreEscuela, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="CCT" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding Cct, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Organización escolar" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding OrganizacionesEscolares}"
                                          DisplayMemberPath="Texto"
                                          SelectedValuePath="Valor"
                                          SelectedValue="{Binding OrganizacionEscolar, Mode=TwoWay}"
                                          AutomationProperties.Name="Organización escolar"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Entidad federativa" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding EntidadesFederativas}"
                                          SelectedItem="{Binding EntidadFederativa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="True"
                                          AutomationProperties.Name="Entidad federativa"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Municipio / alcaldía" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding MunicipiosDisponibles}"
                                          SelectedItem="{Binding Municipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="True"
                                          AutomationProperties.Name="Municipio o alcaldía"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="Localidad" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding Localidad, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Localidad"/>
                                <TextBlock Text="La localidad permanece como texto libre."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="Turno" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding TurnosSugeridos}"
                                          Text="{Binding Turno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          AutomationProperties.Name="Turno"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Grupo y grados atendidos" Style="{StaticResource Heading3}" Margin="0,0,0,4"/>
                        <TextBlock Text="Selecciona uno o varios grados. Dos o más grados convierten el grupo automáticamente en multigrado."
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Grados" Style="{StaticResource FormLabel}"/>
                                <WrapPanel Margin="0,3,0,0">
                                    <CheckBox Content="1.º" IsChecked="{Binding PrimerGrado}" Margin="0,0,14,8" AutomationProperties.Name="Primer grado"/>
                                    <CheckBox Content="2.º" IsChecked="{Binding SegundoGrado}" Margin="0,0,14,8" AutomationProperties.Name="Segundo grado"/>
                                    <CheckBox Content="3.º" IsChecked="{Binding TercerGrado}" Margin="0,0,14,8" AutomationProperties.Name="Tercer grado"/>
                                    <CheckBox Content="4.º" IsChecked="{Binding CuartoGrado}" Margin="0,0,14,8" AutomationProperties.Name="Cuarto grado"/>
                                    <CheckBox Content="5.º" IsChecked="{Binding QuintoGrado}" Margin="0,0,14,8" AutomationProperties.Name="Quinto grado"/>
                                    <CheckBox Content="6.º" IsChecked="{Binding SextoGrado}" Margin="0,0,0,8" AutomationProperties.Name="Sexto grado"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Clave del grupo" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding Grupo, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Clave del grupo"/>
                                <TextBlock Text="Ejemplos: A, B, Único."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="MODALIDAD" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ModalidadGrupo}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="FASE(S) NEM" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FasesNemTexto}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource SectionCard}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="GRADOS" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding GradosTexto}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Referencia de desarrollo" Style="{StaticResource Heading3}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ReferenciaDesarrolloTexto}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Esta referencia se deriva de los grados atendidos. Es contexto pedagógico general y no clasifica ni diagnostica a estudiantes individuales."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Responsabilidad docente" Style="{StaticResource Heading3}" Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Docente responsable" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding DocenteResponsable, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Responsable desde" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding ResponsableDesdeFecha, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Responsable hasta" Style="{StaticResource FormLabel}"/>
                                <DatePicker SelectedDate="{Binding ResponsableHastaFecha, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Horario" Style="{StaticResource Heading3}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hora de entrada (HH:mm)" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding HoraEntrada, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hora de salida (HH:mm)" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding HoraSalida, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Mensaje}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,2,4,6"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="OnCancelarClic" IsCancel="True" MinWidth="96" Margin="0,0,10,0"/>
                <Button Content="Guardar configuración" Style="{StaticResource PrimaryButton}"
                        Click="OnGuardarClic" IsDefault="True" MinWidth="160"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
