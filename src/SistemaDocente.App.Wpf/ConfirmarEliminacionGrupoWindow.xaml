<Window x:Class="SistemaDocente.App.Wpf.ConfirmarEliminacionGrupoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eliminar grupo"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        xml:lang="es-MX">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Eliminar grupo definitivamente"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="GrupoTextBlock"
                       Margin="0,6,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="8"
                Background="{DynamicResource ErrorBackgroundBrush}"
                BorderBrush="{DynamicResource ErrorBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Esta acción elimina también la información asociada al grupo."
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ImpactoTextBlock"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,8,0,0"
                           Text="Antes de eliminar, AulaRaíz creará automáticamente un respaldo local de seguridad. Si ese respaldo falla, no se borrará nada."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="InstruccionTextBlock"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="ConfirmacionTextBox"
                     Margin="0,8,0,0"
                     TextChanged="OnConfirmacionTextChanged"
                     AutomationProperties.Name="Escribe el nombre exacto del grupo para confirmar"/>
            <TextBlock Text="La coincidencia debe ser exacta."
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,20,0,12"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelarClic"
                    AutomationProperties.Name="Cancelar eliminación"/>
            <Button x:Name="EliminarButton"
                    Content="Eliminar definitivamente"
                    IsEnabled="False"
                    Background="{DynamicResource ErrorBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    Foreground="{DynamicResource TextOnPrimaryBrush}"
                    Click="OnEliminarClic"
                    AutomationProperties.Name="Eliminar grupo definitivamente"/>
        </StackPanel>
    </Grid>
</Window>
