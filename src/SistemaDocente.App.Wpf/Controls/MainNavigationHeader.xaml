<UserControl x:Class="SistemaDocente.App.Wpf.Controls.MainNavigationHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:application="clr-namespace:SistemaDocente.Application;assembly=SistemaDocente.Application"
             mc:Ignorable="d"
             d:DesignHeight="76" d:DesignWidth="1280"
             Background="{DynamicResource CardBackgroundBrush}"
             xml:lang="es-MX">
    <UserControl.Resources>
        <Style x:Key="ModernHeaderNavButton" TargetType="Button">
            <Setter Property="Padding" Value="11,22,11,18"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Margin="2,9,2,9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Indicator"
                                    Height="3" Margin="10,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="2,2,0,0"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="activo">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,9">
                <Border Width="46" Height="46" Background="{DynamicResource PrimaryBrush}"
                        BorderBrush="{DynamicResource HeaderIconBackgroundBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="0,0,11,0"
                        AutomationProperties.Name="AulaRaíz">
                    <TextBlock Text="AR" Foreground="{DynamicResource HeaderIconBackgroundBrush}" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static application:IdentidadProducto.Nombre}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold"/>
                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="5"
                                Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                Visibility="{Binding ModoDemostracion, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="DEMO" Foreground="{DynamicResource WarningBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Static application:IdentidadProducto.Subtitulo}"
                               Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource Caption}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                </StackPanel>
            </StackPanel>

            <Menu Grid.Column="2" VerticalAlignment="Center" Margin="14,0,8,0" Background="Transparent"
                  Visibility="{Binding MostrarNavegacion, Converter={StaticResource BoolToVisibility}}">
                <MenuItem x:Name="GrupoContextMenu"
                          Padding="8,5"
                          AutomationProperties.Name="Cambiar contexto de grupo">
                    <MenuItem.Header>
                        <Border Background="{DynamicResource SectionBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,0,9,0">
                                    <TextBlock Text="👥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel MinWidth="120" MaxWidth="180" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Grupo.NombreGrupo}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Cambiar grupo" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                </StackPanel>
                                <TextBlock Text="⌄" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch"
                        Visibility="{Binding MostrarNavegacion, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="NavBtnGrupo" Style="{StaticResource ModernHeaderNavButton}" Content="👥  Grupo" Command="{Binding IrAGrupoCommand}" TabIndex="3" AutomationProperties.Name="Navegar a Grupo"/>
                <Button x:Name="NavBtnAsistencia" Style="{StaticResource ModernHeaderNavButton}" Content="✓  Asistencia" Command="{Binding IrAAsistenciaCommand}" TabIndex="4" AutomationProperties.Name="Navegar a Asistencia"/>
                <Button x:Name="NavBtnProyectos" Style="{StaticResource ModernHeaderNavButton}" Content="▱  Proyectos" Command="{Binding IrAProyectosCommand}" TabIndex="5" AutomationProperties.Name="Navegar a Proyectos"/>
                <Button x:Name="NavBtnEvaluacion" Style="{StaticResource ModernHeaderNavButton}" Content="☆  Evaluación" Command="{Binding IrAEvaluacionCommand}" TabIndex="6" AutomationProperties.Name="Navegar a Evaluación"/>
                <Button x:Name="NavBtnReportes" Style="{StaticResource ModernHeaderNavButton}" Content="▤  Reportes" Command="{Binding IrAReportesCommand}" TabIndex="7" AutomationProperties.Name="Navegar a Reportes"/>
            </StackPanel>

            <Menu Grid.Column="4" VerticalAlignment="Center" Margin="4,0,0,0" Background="Transparent">
                <MenuItem Header="↺  Respaldo" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"
                          Padding="8,8" TabIndex="8" Click="RespaldoRestauracion_Click"
                          AutomationProperties.Name="Abrir respaldo y restauración"/>
                <MenuItem Header="☼  Tema" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"
                          Padding="8,8" TabIndex="9" AutomationProperties.Name="Seleccionar tema">
                    <MenuItem Header="Claro" Click="TemaClaro_Click" AutomationProperties.Name="Tema claro"/>
                    <MenuItem Header="Oscuro" Click="TemaOscuro_Click" AutomationProperties.Name="Tema oscuro"/>
                    <MenuItem Header="Alto contraste" Click="TemaAltoContraste_Click" AutomationProperties.Name="Tema alto contraste"/>
                </MenuItem>
            </Menu>
        </Grid>
    </Border>
</UserControl>